/* ═══════════════════════════════════════════════
   СИНХРОНИЗАЦИЯ month.upDone ИЗ ИСТОРИИ ДНЕЙ
   ═══════════════════════════════════════════════ */
function syncMonthUpFromHistory() {
  // ❗ Если ручной режим — НЕ трогаем upDone
  if (state2.upMonthManual === true) {
    // console.log('⏸ syncMonthUpFromHistory: ручной режим — пропускаю');  /* отладочный вывод отключён */
    return;
  }

    // ❗ Если отчёт отправлен сегодня — НЕ трогаем upDone
  // (он уже включает сегодняшний день)
  const todayStr = new Date().toDateString();
  if (state2.lastDay === todayStr && state2.savedToday === true) {
    // console.log('⏸ syncMonthUpFromHistory: отчёт отправлен сегодня — пропускаю');  /* отладочный вывод отключён */
    return;
  }

  // Считаем сумму УП за текущий месяц из истории
  const h = loadHistory1();
  const now = new Date();
  const month = now.getMonth();
  const year = now.getFullYear();

  let sumUP = 0;
  Object.keys(h).forEach(dateStr => {
    const parts = dateStr.split('.');
    if (parts.length !== 3) return;
    const m = parseInt(parts[1]) - 1;
    const y = parseInt(parts[2]);
    if (m === month && y === year) {
      sumUP += h[dateStr].up || 0;
    }
  });

  const historyUP = Number(sumUP.toFixed(2));
  
  // ─── Учитываем РУЧНУЮ БАЗУ ───
  const base = Number(state2.month.upDoneManualBase || 0);
  const baseDate = state2.month.upDoneManualBaseDate || null;
  
  let finalUP;
  
  if (base > 0 && baseDate) {
    // Считаем, сколько УП появилось в истории ПОСЛЕ базы
    let afterBaseUP = 0;
    Object.keys(h).forEach(dateStr => {
      const parts = dateStr.split('.');
      if (parts.length !== 3) return;
      const m = parseInt(parts[1]) - 1;
      const y = parseInt(parts[2]);
      if (m !== month || y !== year) return;
      
      // Сравниваем даты: только записи ПОСЛЕ baseDate
      const [day, mon, yr] = dateStr.split('.').map(Number);
      const recDate = new Date(yr, mon - 1, day);
      const baseD = new Date(baseDate);
      
      if (recDate > baseD) {
        afterBaseUP += h[dateStr].up || 0;
      }
    });
    
    // Итог = ручная база + дни после неё
    finalUP = Number((base + afterBaseUP).toFixed(2));
  } else {
    // Нет базы — просто сумма из истории
    finalUP = historyUP;
  }
  
  if (state2.month.upDone !== finalUP) {
    // console.log('🔄 syncMonthUp:', state2.month.upDone, '→', finalUP, '(база:', base, ')');  /* отладочный вывод отключён */
    state2.month.upDone = finalUP;
    saveState2(state2);
  }
}
