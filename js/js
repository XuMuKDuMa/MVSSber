(function initKeyboardHide() {
  const body = document.body;
  const vv = window.visualViewport;
  let baseline = Math.max(window.innerHeight || 0, vv ? vv.height : 0);
  let settleTimer = 0;
  const isTextField = el => !!(el && el.matches && el.matches('input, textarea, select, [contenteditable="true"]'));
  function keyboardLooksOpen() {
    const h = vv ? vv.height : window.innerHeight;
    return baseline - h > Math.max(120, baseline * 0.18);
  }
  function updateViewport() {
    const h = vv ? vv.height : window.innerHeight;
    if (keyboardLooksOpen()) {
      body.classList.add('kbd-open');
    } else {
      // Не ждём blur: Android WebView часто оставляет поле в фокусе после скрытия клавиатуры.
      body.classList.remove('kbd-open');
      if (h > baseline) baseline = h;
    }
  }
  document.addEventListener('focusin', e => {
    if (isTextField(e.target)) body.classList.add('kbd-open');
  });
  document.addEventListener('focusout', () => {
    clearTimeout(settleTimer);
    settleTimer = setTimeout(updateViewport, 120);
  });
  window.addEventListener('resize', () => {
    clearTimeout(settleTimer);
    settleTimer = setTimeout(updateViewport, 90);
  });
  if (vv) {
    vv.addEventListener('resize', () => {
      clearTimeout(settleTimer);
      settleTimer = setTimeout(updateViewport, 90);
    });
  }
  window.addEventListener('orientationchange', () => {
    setTimeout(() => {
      baseline = Math.max(window.innerHeight || 0, vv ? vv.height : 0);
      body.classList.remove('kbd-open');
    }, 350);
  });
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) setTimeout(updateViewport, 120);
  });
  // Подхватываем начальный размер после того, как WebView закончит первый layout.
  setTimeout(() => {
    baseline = Math.max(window.innerHeight || 0, vv ? vv.height : 0);
    updateViewport();
  }, 500);
})();;
(function initHeaderCompact() {
  const screenToHeader = {
    2: document.querySelector('#screen2 .r2-header'),
    3: document.querySelector('#screen3 .r1-header'),
  };
  const screenToScroll = {
    1: document.getElementById('screen1'),
    2: document.getElementById('screen2'),
    3: document.getElementById('screen3'),
    4: document.getElementById('screen4'),
  };
  const compacted = { 1: false, 2: false, 3: false, 4: false };
  const COMPACT_THRESHOLD = 30;

  // Автоскрытие плашки итогов на вкладке 1
  const r1Totals = document.getElementById('r1Totals');
  let lastScrollY = { 1: 0 };

  Object.keys(screenToScroll).forEach(n => {
    const el = screenToScroll[n];
    const header = screenToHeader[n];   // может быть null (для screen1 и screen4)
    if (!el) return;

    el.addEventListener('scroll', () => {
      const y = el.scrollTop;

      // ─── Компактная шапка (только если она есть) ───
      if (header) {
        const shouldCompact = y > COMPACT_THRESHOLD;
        if (shouldCompact !== compacted[n]) {
          compacted[n] = shouldCompact;
          header.classList.toggle('compact', shouldCompact);
        }
      }

      // ─── Плашка итогов — только на вкладке 1 ───
      if (n === '1' && r1Totals) {
        const y0 = lastScrollY[1];
        const dy = y - y0;

        // в самом верху — всегда показываем
        if (y < 60) {
          showTotalsSmooth();
          lastScrollY[1] = y;
          return;
        }

        // скролл вниз → плавно уезжает
        if (dy > 10) {
          hideTotalsSmooth();
        }
        // скролл вверх → плавно выезжает
        else if (dy < -10) {
          showTotalsSmooth();
        }

        lastScrollY[1] = y;
      }
    }, { passive: true });
  });
})();
