    menu.style.transition = '';
    menu.style.transform = '';
    menu.style.opacity = '';
    overlay.style.transition = '';
    overlay.style.background = '';
    overlay.style.backdropFilter = '';
    overlay.style.webkitBackdropFilter = '';

    isSwiping = false;

    if (shouldClose) {
      closeStatusMenu();
    }
  }, { passive: true });

  menu.addEventListener('touchcancel', () => {
    if (!isSwiping) return;
    menu.style.transition = '';
    menu.style.transform = '';
    menu.style.opacity = '';
    overlay.style.transition = '';
    overlay.style.background = '';
    overlay.style.backdropFilter = '';
    overlay.style.webkitBackdropFilter = '';
    isSwiping = false;
  }, { passive: true });

  // ⬆️⬆️⬆️ КОНЕЦ БЛОКА СВАЙПА ⬆️⬆️⬆️
}   // ← закрывающая скобка openStatusMenu



