/* ═══════════════════════════════════════════════
   КИЛОМЕТРАЖ: точки маршрута, расчёт по дорогам (OSRM), история по дням
   ═══════════════════════════════════════════════ */
function kmLoadPoints() {
  try {
    const p = JSON.parse(localStorage.getItem('route_points') || '{}') || {};
    return { start: (p.start || '').trim(), end: (p.end || '').trim(), sameEnd: p.sameEnd !== false };
  } catch (e) { return { start: '', end: '', sameEnd: true }; }
}
function kmSavePoints(p) { try { localStorage.setItem('route_points', JSON.stringify(p)); } catch (e) {} }
function kmLoadHistory() {
  try { return JSON.parse(localStorage.getItem('km_history') || '{}') || {}; } catch (e) { return {}; }
}
function kmSaveHistory(h) { try { localStorage.setItem('km_history', JSON.stringify(h)); } catch (e) {} }
function kmDayKey() {
  const d = new Date();
  if (d.getHours() >= 23) d.setDate(d.getDate() + 1);   // как у рабочего дня приложения
  return d.toLocaleDateString('ru-RU');
}
function kmFmt(km) { return (Math.round(km * 10) / 10).toFixed(1).replace('.', ',') + ' км'; }
function kmHaversine(a, b) {
  const R = 6371, rad = Math.PI / 180;
  const dLat = (b[0] - a[0]) * rad, dLon = (b[1] - a[1]) * rad;
  const x = Math.sin(dLat / 2) ** 2 + Math.cos(a[0] * rad) * Math.cos(b[0] * rad) * Math.sin(dLon / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(x));
}
// Расстояние по дорогам для машины. Если сервис недоступен — по прямой × 1.3 (approx = true)
async function kmRoadDistance(coords) {
  if (coords.length < 2) return { km: 0, approx: false };
  try {
    const ctrl = new AbortController();
    const to = setTimeout(() => ctrl.abort(), 15000);
    const path = coords.map(c => c[1].toFixed(6) + ',' + c[0].toFixed(6)).join(';');
    const r = await fetch('https://router.project-osrm.org/route/v1/driving/' + path + '?overview=false', { signal: ctrl.signal });
    clearTimeout(to);
    const d = await r.json();
    if (d && d.code === 'Ok' && d.routes && d.routes[0]) return { km: d.routes[0].distance / 1000, approx: false };
  } catch (e) { console.warn('OSRM error:', e); }
  let sum = 0;
  for (let i = 1; i < coords.length; i++) sum += kmHaversine(coords[i - 1], coords[i]);
  return { km: sum * 1.3, approx: true };
}
function kmGatherStops() {
  // Ездили на адрес, если: нажали «Маршрут» на карте ИЛИ встреча закрыта «Готово».
  // Порядок точек: по времени нажатия «Маршрут» / закрытия встречи; если времени нет — по слотам.
  const dayStart = new Date(); dayStart.setHours(0, 0, 0, 0);
  const visited = [];
  ROUTE_TIMES.forEach((t, si) => {
    (routeState.lists[t.id] || []).forEach((it, ii) => {
      if (!it || !it.addr || !it.addr.trim() || it.status === 'perenos') return;
      if (!(it.navAt || it.status === 'done')) return;
      const at = it.navAt || it.doneAt || (dayStart.getTime() + si * 3600000 + ii * 1000);
      visited.push({ addr: it.addr.trim(), at });
    });
  });
  visited.sort((x, y) => x.at - y.at);
  return visited.map(v => v.addr);
}
function kmSignature() {
  const p = kmLoadPoints();
  return JSON.stringify([getMyCity(), p.start, p.sameEnd ? p.start : p.end, kmGatherStops()]);
}
async function kmGeocode(addr, noCity) {
  const t0 = Date.now();
  const c = await geocodeAddress(addr, noCity);
  if (Date.now() - t0 > 80) await new Promise(r => setTimeout(r, 1100));   // лимит Nominatim: ~1 запрос/сек
  return c;
}

let _kmBusy = false, _kmTimer = null;
function kmSchedule() {
  clearTimeout(_kmTimer);
  _kmTimer = setTimeout(() => { kmRecalcToday(false); }, 4000);
}
async function kmRecalcToday(force) {
  if (_kmBusy) return;
  const key = kmDayKey();
  const sig = kmSignature();
  let h = kmLoadHistory();
  if (h[key] && h[key].manual) {
    if (force !== 'reset') return;          // введено вручную — не трогаем
    delete h[key]; kmSaveHistory(h);        // «Пересчитать сегодня» снимает ручное значение
  }
  if (!force && h[key] && h[key].sig === sig) return;

  const stops = kmGatherStops();
  if (!stops.length) {
    if (h[key]) { delete h[key]; kmSaveHistory(h); kmRefreshSection(); }
    return;
  }
  // navigator.onLine в WebView на мобильной сети бывает ложным «нет» — не проверяем, просто пробуем

  _kmBusy = true;
  try {
    const p = kmLoadPoints();
    const coords = [];
    let skipped = 0, pointMissing = 0;
    const push = (c) => {
      const last = coords[coords.length - 1];
      if (!last || Math.abs(last[0] - c[0]) > 1e-5 || Math.abs(last[1] - c[1]) > 1e-5) coords.push(c);
    };
    if (p.start) { const c = await kmGeocode(p.start, true); if (c) push(c); else pointMissing++; }
    for (const addr of stops) {
      const c = await kmGeocode(addr, false);
      if (c) push(c); else skipped++;
    }
    const endAddr = p.sameEnd ? p.start : p.end;
    if (endAddr) { const c = await kmGeocode(endAddr, true); if (c) push(c); else pointMissing++; }

    const res = await kmRoadDistance(coords);
    const h2 = kmLoadHistory();
    h2[key] = {
      km: Math.round(res.km * 10) / 10,
      stops: stops.length - skipped,
      skipped, pointMissing,
      approx: res.approx,
      sig: res.approx ? null : sig,     // при приближённом расчёте — попробуем ещё раз позже
      ts: Date.now()
    };
    kmSaveHistory(h2);
    kmRefreshSection();
  } catch (e) {
    console.warn('km calc error:', e);
  } finally {
    _kmBusy = false;
  }
  if (kmSignature() !== sig) kmSchedule();   // пока считали — маршрут поменялся
}

function kmMonthData(ref) {
  const h = kmLoadHistory();
  const now = ref || new Date();
  const rows = [];
  let total = 0;
  Object.keys(h).forEach(ds => {
    const p = ds.split('.');
    if (p.length !== 3) return;
    if (parseInt(p[1], 10) - 1 === now.getMonth() && parseInt(p[2], 10) === now.getFullYear()) {
      rows.push(Object.assign({ date: ds, day: parseInt(p[0], 10) }, h[ds]));
      total += h[ds].km || 0;
    }
  });
  rows.sort((a, b) => a.day - b.day);
  return { rows, total };
}
