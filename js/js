    const bad = () => {
      if (done) return; done = true; clearTimeout(t);
      try { sc.remove(); link.remove(); } catch (e) {}
      tryOne(i + 1);
    };
    const t = setTimeout(bad, s.timeout);
    sc.onload = () => {
      if (done) return;
      if (!(window.L && window.L.map)) { bad(); return; }   // файл пришёл, но это не Leaflet (например, страница 404)
      done = true; clearTimeout(t); finish(s.name);
    };
    sc.onerror = bad;
    sc.src = s.js;
    document.head.appendChild(sc);
  };
  tryOne(0);
}
