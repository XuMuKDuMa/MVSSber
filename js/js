function autoGrow(el) {
  if (el && window.mvsGrowField) window.mvsGrowField(el);   // единый модуль в конце файла; не трогает поле во время набора
}

function persistAddressInput() {
  // Поле показывает короткий адрес (улица, дом). Если текст не менялся — полный адрес для карты не трогаем.
  const shown = String(item.addrDisplay || item.addr || '');
  if (addrInput.value === shown) { autoGrow(addrInput); return; }
  item.addr = addrInput.value;          // ручная правка — это и есть новый адрес
  item.addrDisplay = addrInput.value;
  addrCollapsed.textContent = item.addrDisplay || '';
  saveRouteState(routeState);
  autoGrow(addrInput);
  _mapHash = '';
}

addrInput.addEventListener('compositionstart', () => {
  addrInput.dataset.composing = '1';
});
addrInput.addEventListener('compositionend', () => {
  delete addrInput.dataset.composing;
  persistAddressInput();
});
addrInput.addEventListener('input', () => {
  autoGrow(addrInput);
  // Во время ввода русских букв Android сначала собирает композицию.
  // Не перезаписываем состояние до compositionend.
  if (addrInput.dataset.composing !== '1') persistAddressInput();
});
addrInput.addEventListener('change', persistAddressInput);
addrInput.addEventListener('blur', persistAddressInput);
addrInput.addEventListener('focus', () => requestAnimationFrame(() => autoGrow(addrInput)));
addrInput.addEventListener('keyup', () => autoGrow(addrInput));
addrInput.addEventListener('keydown', e => e.stopPropagation());
