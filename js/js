// ═══════════════════════════════════════════════
//  ТИП ВСТРЕЧИ НА КАРТОЧКЕ → автозапись УП в «Сегодня»
// ═══════════════════════════════════════════════
// id совпадают с реестром SECTIONS1 (кроме 'zk' — он ведётся отдельным полем ЗК)
function getMeetingTypes() {
  return {
    b2c: [
      { id: 'fd_meet_02',  label: 'ФД обычная' },
      { id: 'fd_meet_035', label: 'ФД детская с вериф.' },
      { id: 'fd_meet_dbo', label: 'ФД ДБО' },
      { id: 'fd_meet_sim', label: 'ФД Сим' },
    ],
    b2b: [
      { id: 'biz_rko',  label: 'РКО' },
      { id: 'biz_ip',   label: 'Идентификация ИП' },
      { id: 'biz_card', label: 'Бизнес карта' },
      { id: 'zk',       label: 'ЗК' },
    ],
  };
}
function meetingTypeUp(mid) {
  if (!mid) return 0;
  try {
    if (mid === 'zk') return ZK_COEF;
    for (const sec of SECTIONS1) for (const it of sec.items) if (it.id === mid) return it.up;
  } catch (e) {}
  return 0;
}
function creditUpLabel(mid) {
  const u = meetingTypeUp(mid);
  return u ? ' · +' + u.toFixed(2) + ' УП' : '';
}
// +1 / −1 к счётчику в «Сегодня»
function creditMeetingType(mid, delta) {
  if (!mid) return;
  if (mid === 'zk') {
    const nv = Math.max(0, Math.round(num(getZK1())) + delta);
    setZK1(nv ? String(nv) : '');
    const inp = document.getElementById('zkInput1');
    if (inp) inp.value = nv ? String(nv) : '';
    return;
  }
  setCount1(mid, getCount1(mid) + delta);
}
// ─── Встреча проведена «не в слот»: время старта вне окна слота ±15 минут ───
// Слот 10–12 → засчитывается с 9:45 до 12:45
function slotWindowOf(timeId, refMs) {
  const m = /^t(\d+)_(\d+)$/.exec(timeId || '');
  if (!m) return null;
  const a = new Date(refMs); a.setHours(parseInt(m[1], 10), 0, 0, 0);
  const b = new Date(refMs); b.setHours(parseInt(m[2], 10), 0, 0, 0);
  return [a.getTime() - 15 * 60000, b.getTime() + 15 * 60000];
}
// Автоопределение (без ручной правки)
function slotAutoOut(item, timeId) {
  if (!item || item.status !== 'done') return false;
  const when = item.meetStart || item.doneAt;   // время «Начать», иначе время «Готово»
  if (!when) return false;                       // время неизвестно — считаем «в слот»
  const w = slotWindowOf(timeId, when);
  return !!w && (when < w[0] || when > w[1]);
}
function isOutOfSlot(item, timeId) {
  if (!item || item.status !== 'done') return false;
  if (item.slotForce === 'in') return false;     // поправлено вручную
  return slotAutoOut(item, timeId);
}
// Тип по умолчанию: первый в категории (B2C → ФД обычная, B2B → РКО)
function mtypeLabelOf(item) {
  const id = effectiveMtype(item);
  const t = (getMeetingTypes()[item.category || 'b2c'] || []).find(x => x.id === id);
  return t ? t.label : '—';
}
function effectiveMtype(item) {
  const list = getMeetingTypes()[item.category || 'b2c'] || [];
  if (item.mtype && list.some(t => t.id === item.mtype)) return item.mtype;
  return list.length ? list[0].id : null;
}
// Приводит запись УП в соответствие с карточкой: «Готово» + выбран тип → записано, иначе → снято
function syncCardCredit(item) {
  if (!item) return;
  const desired = (item.status === 'done') ? effectiveMtype(item) : null;
  // Время закрытия встречи — нужно для порядка точек в километраже
  if (item.status === 'done') { if (!item.doneAt) item.doneAt = Date.now(); }
  else if (item.doneAt) {
    item.doneAt = null;
    item.slotForce = null;
    if (!item.startedAt) item.meetStart = null;   // встречу «разоткрыли» — время старта устарело
  }
  if (item.credited && item.credited !== desired) {
    creditMeetingType(item.credited, -1);
    item.credited = null;
  }
  if (desired && item.credited !== desired) {
    creditMeetingType(desired, +1);
    item.credited = desired;
  }
  saveRouteState(routeState);
}
// Карточку удаляют — снять УП, если он был записан
function uncreditCard(item) {
  if (item && item.credited) {
    creditMeetingType(item.credited, -1);
    item.credited = null;
  }
}
// (подсказка «тип не выбран» не нужна: тип всегда есть — по умолчанию первый)
function noTypeHint() {}
// Тип не из текущей категории (сменили B2C ↔ B2B) — сбросить
function resetMtypeForCategory(item) {
  const list = getMeetingTypes()[item.category || 'b2c'] || [];
  if (item.mtype && !list.some(t => t.id === item.mtype)) item.mtype = null;
  syncCardCredit(item);   // у «Готово» УП перейдёт на тип по умолчанию новой категории
}

// ─── Уточнение: действительно ли детская карта оформлена с верификацией ───
function askChildVerification(onAnswer) {
