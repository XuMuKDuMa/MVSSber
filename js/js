  setInterval(function () { run('timer'); }, EVERY);
})();

// Окно редактирования «Заметки» и «Причины недоставки» — в том же стиле, что «Добавить адреса в слот»:
// затемнение, центральная карточка, заголовок, пояснение, кнопки «Отмена» / «Сохранить».
(function () {
