  track.style.transform = `translate3d(${offset}px, 0, 0)`;
  // console.log('Transform:', track.style.transform);  /* отладочный вывод отключён */
  
  // Точки
  document.querySelectorAll('.meetings-dots .dot').forEach((dot, i) => {
