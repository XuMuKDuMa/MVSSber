    const sc = document.createElement('script');
    const cleanup = () => { clearTimeout(timer); try { delete window[name]; } catch (e) { window[name] = undefined; } sc.remove(); };
    const timer = setTimeout(() => { cleanup(); reject(new Error('timeout')); }, timeout);
    window[name] = (d) => { cleanup(); resolve(d); };
    sc.onerror = () => { cleanup(); reject(new Error('script blocked')); };
