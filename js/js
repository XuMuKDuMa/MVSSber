// ─── Завершить встречу одной кнопкой ───
function quickFinishMeeting(item) {
  const complete = (verified) => {
    // «Нет» или перевыпуск/стикер: заменить детскую ФД с верификацией на обычную ФД (0,20 УП)
    if (verified === false) item.mtype = 'fd_meet_02';
    const _began = item.startedAt;
    item.status = 'done';
    item.startedAt = null;
    syncCardCredit(item);
    saveRouteState(routeState);
    renderRoute();
    if (typeof updateDrawerRoutes === 'function') updateDrawerRoutes();
    updateActivitiesBadge();
    _mapHash = '';
    if (map) renderMapMarkers();
    vibro(15);
    let _dur = '';
    if (_began) {
      const mins = Math.max(1, Math.round((Date.now() - _began) / 60000));
      _dur = 'Длилась ' + (mins < 60 ? mins + ' мин' : Math.floor(mins / 60) + ' ч ' + String(mins % 60).padStart(2, '0') + ' мин');
    }
    showSuccessNotification('Встреча проведена' + creditUpLabel(item.credited), 'done', _dur);
    noTypeHint(item);
  };
  if (effectiveMtype(item) === 'fd_meet_035') {
    askChildVerification(answer => {
      // Закрытие диалога крестом/кликом вне окна не должно случайно завершить встречу.
      if (answer === null) return;
      complete(answer);
    });
  } else {
    complete(true);
  }
}

// ─── Адрес уже пробовали искать на карте и не нашли? ───
function isAddrUnresolved(addr) {
  const raw = (addr || '').trim();
  if (!raw || typeof mapGeocache === 'undefined' || !mapGeocache) return false;
  const key1 = applyCity(raw).trim();
  let key2 = key1;
  const city = getMyCity();
  if (city && !key2.toLowerCase().includes(city.toLowerCase())) key2 = city + ', ' + key2;
  // вручную указанные координаты (или найденные) — всё в порядке
  if (Array.isArray(mapGeocache[key1]) || Array.isArray(mapGeocache[key2])) return false;
  const has = (k) => Object.prototype.hasOwnProperty.call(mapGeocache, k);
  return (has(key1) && mapGeocache[key1] === null) || (has(key2) && mapGeocache[key2] === null);
}

function sortRouteList(timeId) {
  const list = routeState.lists[timeId];
  if (!Array.isArray(list)) return;
  const rank = (s) => {
    if (s === 'wait')    return 1;
    if (s === null || s === undefined) return 2;
    if (s === 'ndz')     return 3;
    if (s === 'done')    return 4;
    if (s === 'perenos') return 5;
    return 2;
  };
  list.sort((a, b) => rank(a.status) - rank(b.status));
}
