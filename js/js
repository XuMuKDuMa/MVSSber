/* ═══════════════════════════════════════════════
   ТАЙМЕР ВНУТРИ СЛОТА (сколько осталось до конца)
   ═══════════════════════════════════════════════ */
function getSlotRemaining(slotId) {
  // Расписание слотов + буферы 15 минут
  const SLOTS = {
    't10_12': { startH: 10, endH: 12 },
    't12_14': { startH: 12, endH: 14 },
    't14_16': { startH: 14, endH: 16 },
    't16_18': { startH: 16, endH: 18 },
  };
  
  const BUFFER_MIN = 15;   // ← буфер 15 минут до и после
  
  const slot = SLOTS[slotId];
  if (!slot) return null;
  
  const now = new Date();
  const nowSec = now.getHours() * 3600 + now.getMinutes() * 60 + now.getSeconds();
  
  // Реальное окно слота = [start - 15мин, end + 15мин]
  const startSec = slot.startH * 3600 - BUFFER_MIN * 60;
  const endSec   = slot.endH   * 3600 + BUFFER_MIN * 60;
  
  let diffSec;
  let mode;
  
  if (nowSec < startSec) {
    // До открытия окна — показываем полное окно
    diffSec = endSec - startSec;
    mode = 'before';
  } else if (nowSec > endSec) {
    // Окно закрылось
    diffSec = 0;
    mode = 'done';
  } else {
    // Окно открыто — сколько осталось
    diffSec = endSec - nowSec;
    mode = 'active';
  }
  
  const hh = Math.floor(diffSec / 3600);
  const mm = Math.floor((diffSec % 3600) / 60);
  const hours = String(hh).padStart(1, '0');
  const mins = String(mm).padStart(2, '0');
  const timeStr = hours + '.' + mins;
  
  return { timeStr, mode };
}
/* ═══════════════════════════════════════════════
   ОБНОВЛЕНИЕ АКТИВНОГО СЛОТА (каждую минуту)
   ═══════════════════════════════════════════════ */
function updateActiveSlotPulse() {
  const now = new Date();
  const nowMin = now.getHours() * 60 + now.getMinutes();
  const SLOTS_TIME = {
    't10_12': { start: 10 * 60, end: 12 * 60 },
    't12_14': { start: 12 * 60, end: 14 * 60 },
    't14_16': { start: 14 * 60, end: 16 * 60 },
    't16_18': { start: 16 * 60, end: 18 * 60 },
  };
  
  document.querySelectorAll('#screen4 .slot-btn').forEach(btn => {
    const slotId = btn.dataset.slotId;
    const slot = SLOTS_TIME[slotId];
    if (!slot) return;
    
    const BUFFER = 15;
const isActive = nowMin >= (slot.start - BUFFER) && nowMin < (slot.end + BUFFER);
    const isOpen = btn.classList.contains('active');
    
    btn.classList.toggle('slot-live', isActive && !isOpen);
  });
}

setInterval(updateActiveSlotPulse, 60000);   // каждую минуту


function updateSlotTimers() {
  document.querySelectorAll('[data-slot-timer]').forEach(el => {
    const slotId = el.dataset.slotTimer;
    const result = getSlotRemaining(slotId);
    if (!result) return;
    
    if (el.textContent !== result.timeStr) {
      el.textContent = result.timeStr;
    }
    
    el.classList.toggle('slot-timer-before', result.mode === 'before');
    el.classList.toggle('slot-timer-active', result.mode === 'active');
    el.classList.toggle('slot-timer-done',   result.mode === 'done');
  });
}

