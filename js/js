function getPrevMonthKey() {
  const now = new Date();
  const prev = new Date(now.getFullYear(), now.getMonth() - 1, 1);
  return prev.getFullYear() + '-' + String(prev.getMonth() + 1).padStart(2, '0');
}

function shouldShowMonthlyReport() {
  return localStorage.getItem(MONTHLY_REPORT_KEY) !== getPrevMonthKey();
}

function collectMonthlyReportByMonth(year, month) {
  const d = new Date(year, month, 1);
  const sales = getSalesForMonth(year, month);
  const meetings = getMeetingsForMonth(year, month);

  const h = loadHistory1();
  let sumOD = 0, sumMeetings = 0, days = 0;
  Object.keys(h).forEach(dateStr => {
    const parts = dateStr.split('.');
    if (parts.length !== 3) return;
    const m = parseInt(parts[1]) - 1, y = parseInt(parts[2]);
    if (m !== month || y !== year) return;
    days++;
    sumOD += h[dateStr].od || 0;
    sumMeetings += h[dateStr].meetings || 0;
  });

  // ─── УП за месяц — из МВС, если это текущий месяц ───
  const now = new Date();
  let sumUP;
  if (year === now.getFullYear() && month === now.getMonth()) {
    // Текущий месяц — берём из state2 (МВС)
    sumUP = Number(state2.month?.upDone || 0);
  } else {
    // Прошлый месяц — суммируем из истории
    sumUP = 0;
    Object.keys(h).forEach(dateStr => {
      const parts = dateStr.split('.');
      if (parts.length !== 3) return;
      const m = parseInt(parts[1]) - 1, y = parseInt(parts[2]);
      if (m === month && y === year) {
        sumUP += h[dateStr].up || 0;
      }
    });
  }

  return {
    year, month,
    monthName: d.toLocaleDateString('ru-RU', { month: 'long', year: 'numeric' }),
    sales, meetings,
    totals: { up: sumUP, od: sumOD, meetings: sumMeetings, days }
  };
}

function collectPrevMonthlyReportByMonth(year, month) {
  const prev = new Date(year, month - 1, 1);
  const py = prev.getFullYear();
  const pm = prev.getMonth();

  const sales = getSalesForMonth(py, pm);
  const meetings = getMeetingsForMonth(py, pm);

  const h = loadHistory1();
  let sumUP = 0, days = 0;
  Object.keys(h).forEach(dateStr => {
    const parts = dateStr.split('.');
    if (parts.length !== 3) return;
    const m = parseInt(parts[1]) - 1, y = parseInt(parts[2]);
    if (m !== pm || y !== py) return;
    days++;
    sumUP += h[dateStr].up || 0;
  });

  return { year: py, month: pm, sales, meetings, totals: { up: sumUP, days } };
}

function collectMonthlyReport() {
  const now = new Date();
  const prev = new Date(now.getFullYear(), now.getMonth() - 1, 1);
  return collectMonthlyReportByMonth(prev.getFullYear(), prev.getMonth());
}

function collectPrevMonthlyReport() {
  const now = new Date();
  const prev = new Date(now.getFullYear(), now.getMonth() - 2, 1);
  return collectPrevMonthlyReportByMonth(prev.getFullYear(), prev.getMonth());
}

