function buildMonthlyReportText() {
  const cache = document.getElementById('monthlyBody').dataset.reportCache;
  if (!cache) return '';
  const d = JSON.parse(cache);

  function diffLine(cur, prev) {
    if (prev === 0 && cur === 0) return '';
    if (prev === 0) return '';
    const diff = cur - prev;
    const pct = (diff / prev * 100).toFixed(1);
    const sign = diff > 0 ? '+' : '';
    return ` (${sign}${diff.toFixed(2)}, ${sign}${pct}%)`;
  }

  let t = `📊 Анализ за ${d.month}\n\n`;
  t += `УП: ${d.totals.up.toFixed(2)}${diffLine(d.totals.up, d.prev.up)}\n`;
  t += `ОД: ${d.totals.od}\n`;
  t += `Рабочих дней: ${d.totals.days}\n`;
  t += `Встреч всего: ${d.totals.meetings}\n`;
  t += `УП в день: ${d.totals.days ? (d.totals.up / d.totals.days).toFixed(2) : '—'}\n\n`;

  const salesSum = d.sales.reduce((s, e) => s + e.count, 0);
  t += `📊 Продажи (${d.sales.length} видов, ${salesSum} шт)${diffLine(salesSum, d.prev.sales)}\n`;
  d.sales.forEach(e => { t += `  ${e.count} × ${e.name}\n`; });
  t += '\n';

  t += `👤 B2C — физлица (${d.b2cSum})${diffLine(d.b2cSum, d.prev.b2c)}\n`;
  d.b2c.forEach(e => { t += `  ${e.value} × ${e.name}\n`; });
  t += '\n';

  t += `🏢 B2B — юрлица (${d.b2bSum})${diffLine(d.b2bSum, d.prev.b2b)}\n`;
  d.b2b.forEach(e => { t += `  ${e.value} × ${e.name}\n`; });

  return t;
}

