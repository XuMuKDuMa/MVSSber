/* ═══════════════════════════════════════════════
   ТАЙМЕР РАБОЧЕГО ДНЯ (09:00 — 18:00)
   ═══════════════════════════════════════════════ */
function updateWorkTimer() {
  const now = new Date();
  const hours = now.getHours();
  const minutes = now.getMinutes();
  const seconds = now.getSeconds();
  
  // Рабочий день: 09:00 — 18:00 (9 часов)
  const WORK_START_H = 9;
  const WORK_END_H = 18;
  
  // Текущее время в секундах от полуночи
  const nowSec = hours * 3600 + minutes * 60 + seconds;
  const startSec = WORK_START_H * 3600;    // 32400 (09:00)
  const endSec = WORK_END_H * 3600;        // 64800 (18:00)
  
  let diffSec;
  let mode;  // 'before' | 'work' | 'overtime'
  
  if (nowSec < startSec) {
    // До 09:00 — показываем полный день
    diffSec = endSec - startSec;
    mode = 'before';
  } else if (nowSec > endSec) {
    // После 18:00 — переработка
    diffSec = nowSec - endSec;
    mode = 'overtime';
  } else {
    // Рабочее время — сколько осталось
    diffSec = endSec - nowSec;
    mode = 'work';
  }
  
  // Форматируем: 480 минут → "08:00"
  const hh = Math.floor(diffSec / 3600);
  const mm = Math.floor((diffSec % 3600) / 60);
  
  const timeStr = 
    String(hh).padStart(2, '0') + ':' +
    String(mm).padStart(2, '0');
  
  // Показываем знак "минус" для переработки
  const display = (mode === 'overtime' ? '-' : '') + timeStr;
  
  // Обновляем все таймеры на странице
  document.querySelectorAll('.work-timer').forEach(el => {
    if (el.textContent !== display) {
      el.textContent = display;
    }
    
    // Классы для цвета
    el.classList.toggle('overtime', mode === 'overtime');
    el.classList.toggle('before', mode === 'before');
    el.classList.toggle('work', mode === 'work');
  });
}

// Обновляем каждую секунду
setInterval(updateWorkTimer, 1000);
