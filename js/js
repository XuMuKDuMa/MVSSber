function mvsStreetOnlyAddress(raw) {
  const value = String(raw || '').trim();
  if (!value) return '';
  const parts = value.split(',').map(x => x.trim()).filter(Boolean);
  const streetPattern = /(?:^|\s)(?:улица|ул\.?|проспект|пр-т|шоссе|перек[её]сток|переулок|пер\.?|бульвар|бул\.?|проезд|набере?жная|набережная|площадь|аллея|дорога|микрорайон|мкр\.?)(?:\s|$)/i;
  let start = parts.findIndex(part => streetPattern.test(part));
  if (start >= 0) {
    const chosen = parts.slice(start, Math.min(parts.length, start + 2));
    return chosen.join(', ').replace(/^(?:дом|д\.?|корпус|корп\.?|строение|стр\.?)[,\s]+/i, '').trim();
  }
  // If no explicit street type is present, prefer the final locality/address components
  // rather than showing country and region prefixes.
  if (parts.length >= 3) return parts.slice(-2).join(', ');
  return value;
}

