   ═══════════════════════════════════════════════ */
function normalizeNumbers(text) {
  if (!text) return text;
  
  const words = {
    'ноль': '0', 'нуль': '0',
    'один': '1', 'одна': '1', 'одно': '1', 'первый': '1', 'первая': '1', 'первое': '1',
    'два': '2', 'две': '2', 'второй': '2', 'вторая': '2', 'второе': '2',
    'три': '3', 'третий': '3', 'третья': '3', 'третье': '3',
    'четыре': '4', 'четвертый': '4', 'четвёртый': '4', 'четвертая': '4', 'четвёртая': '4',
    'пять': '5', 'пятый': '5', 'пятая': '5',
    'шесть': '6', 'шестой': '6', 'шестая': '6',
    'семь': '7', 'седьмой': '7', 'седьмая': '7',
    'восемь': '8', 'восьмой': '8', 'восьмая': '8',
    'девять': '9', 'девятый': '9', 'девятая': '9',
    'десять': '10', 'десятый': '10',
    'одиннадцать': '11', 'двенадцать': '12', 'тринадцать': '13', 'четырнадцать': '14',
    'пятнадцать': '15', 'шестнадцать': '16', 'семнадцать': '17', 'восемнадцать': '18',
    'девятнадцать': '19', 'двадцать': '20', 'тридцать': '30', 'сорок': '40',
    'пятьдесят': '50', 'шестьдесят': '60', 'семьдесят': '70', 'восемьдесят': '80',
    'девяносто': '90', 'сто': '100'
  };
  
  let result = text;
  Object.keys(words).forEach(word => {
  // \b не работает с кириллицей — используем lookbehind/lookahead
  // Ищем слово как отдельное: не буква слева и не буква справа
  const regex = new RegExp(
    '(?<![а-яёa-z])' + word + '(?![а-яёa-z])',
    'gi'
  );
  result = result.replace(regex, words[word]);
});
  
  return result;
}

