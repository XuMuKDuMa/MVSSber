// ─── НАДЁЖНЫЕ ПОДСКАЗКИ АДРЕСОВ DADATA ───
// Используем прямой API, чтобы поиск не зависел от локальных suggestions.min.js/css.
// Ограничение по city_fias_id удалено: ранее был указан неверный идентификатор региона.
(function initMvsDaDataAutocomplete() {
  const getDaDataApiKey = () => { try { return (localStorage.getItem("mvs_dadata_api_key") || "").trim(); } catch (_) { return ""; } };
  const endpoint = 'https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/address';
  let timer = null;
  let controller = null;
  let requestSeq = 0;
  let activeIndex = -1;
  let suggestions = [];

  const list = document.createElement('div');
  list.className = 'mvs-dadata-list';
  list.setAttribute('role', 'listbox');
  list.style.display = 'none';
  document.body.appendChild(list);

  function positionList() {
    const r = addrInput.getBoundingClientRect();
    const gap = 6;
    const maxH = Math.min(260, Math.round(window.innerHeight * 0.34));
    const availableAbove = Math.max(0, r.top - gap - 8);
    const availableBelow = Math.max(0, window.innerHeight - r.bottom - gap - 8);
    const desired = Math.min(list.scrollHeight || maxH, maxH);
    const placeAbove = availableAbove >= Math.min(desired, 110) || availableAbove >= availableBelow;
    const actualH = Math.min(desired, placeAbove ? availableAbove : availableBelow);
    list.style.left = Math.max(8, Math.min(r.left, window.innerWidth - 128)) + 'px';
    list.style.width = Math.max(120, Math.min(r.width, window.innerWidth - Math.max(8, r.left) - 8)) + 'px';
    list.style.maxHeight = Math.max(80, actualH) + 'px';
    list.style.top = (placeAbove ? Math.max(8, r.top - Math.max(80, actualH) - gap) : r.bottom + gap) + 'px';
  }
  window.addEventListener('resize', () => { if (list.style.display === 'block') positionList(); });
  window.addEventListener('scroll', () => { if (list.style.display === 'block') positionList(); }, true);
  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', () => { if (list.style.display === 'block') positionList(); });
    window.visualViewport.addEventListener('scroll', () => { if (list.style.display === 'block') positionList(); });
  }

  function closeList() {
    list.style.display = 'none';
    list.replaceChildren();
    suggestions = [];
    activeIndex = -1;
  }
  function choose(s) {
    if (!s) return;
    const selectedAddress = s.value || (s.data && s.data.address);
    if (!selectedAddress) return;
    // В поле оставляем короткий адрес улицы и дома, полный адрес сохраняем для карты.
    const d = s.data || {};
    const street = d.street_with_type || d.street || d.route || '';
    const houseFull = [d.house_type, d.house, d.block_type, d.block].filter(Boolean).join(' ').trim();
    let compactAddress = [street, houseFull].filter(Boolean).join(', ').trim();
    if (!compactAddress) compactAddress = (typeof mvsStreetOnlyAddress === 'function' ? mvsStreetOnlyAddress(selectedAddress) : '') || selectedAddress;
    addrInput.value = compactAddress;           // в поле — только улица и дом, без «Россия, область, город…»
    item.addrDisplay = compactAddress;
    addrInput.dataset.fullAddress = selectedAddress;
    item.addr = selectedAddress;                // полный адрес остаётся для карты и геокодера
    addrCollapsed.textContent = compactAddress;
    saveRouteState(routeState);
    autoGrow(addrInput);
    if (s.data && s.data.geo_lat && s.data.geo_lon) {
      const lat = Number(s.data.geo_lat), lon = Number(s.data.geo_lon);
      if (Number.isFinite(lat) && Number.isFinite(lon)) {
        mapGeocache[selectedAddress] = [lat, lon];
        saveGeocache();
        _mapHash = '';
        if (map) renderMapMarkers();
      }
    }
    closeList();
  }
  function show(items) {
    suggestions = items || [];
    activeIndex = -1;
    list.replaceChildren();
    if (!suggestions.length) { closeList(); return; }
    suggestions.forEach((s, i) => {
      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'mvs-dadata-option';
      row.setAttribute('role', 'option');
      const main = document.createElement('span');
      main.className = 'mvs-dadata-main';
      const d = s.data || {};
      // Подсказка в две строки: улица и дом, затем населённый пункт.
      const streetPart = d.street_with_type || d.street || '';
      const housePart = d.house || '';
      const mainPart = [streetPart, housePart].filter(Boolean).join(' ').trim();
      main.textContent = mainPart || s.value || '';
      row.appendChild(main);
      const sub = document.createElement('span');
      sub.className = 'mvs-dadata-sub';
      const cityPart = d.city || d.settlement || d.city_with_type || d.settlement_with_type || getMyCity() || '';
      sub.textContent = cityPart + (d.postal_code ? ' · ' + d.postal_code : '');
      row.appendChild(sub);
      // Не даём мобильному браузеру снять фокус с поля до выбора подсказки.
      row.addEventListener('pointerdown', e => { e.preventDefault(); }, { passive: false });
      row.addEventListener('mousedown', e => { e.preventDefault(); });
      row.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); choose(s); });
      row.addEventListener('mouseenter', () => setActive(i));
      list.appendChild(row);
    });
    list.style.display = 'block';
    positionList();
    requestAnimationFrame(positionList);
  }
  function setActive(i) {
    const rows = [...list.querySelectorAll('.mvs-dadata-option')];
    if (!rows.length) return;
    activeIndex = (i + rows.length) % rows.length;
    rows.forEach((row, n) => {
      row.classList.toggle('active', n === activeIndex);
      row.setAttribute('aria-selected', n === activeIndex ? 'true' : 'false');
    });
    rows[activeIndex].scrollIntoView({block:'nearest'});
  }
  async function search(query, seq) {
    if (controller) controller.abort();
    controller = new AbortController();
    const city = getMyCity();
    const body = { query, count: 8, language: 'ru', locations: [{ country: '*', ...(city ? { city } : {}) }] };
    try {
      const apiKey = getDaDataApiKey();
      if (!apiKey) throw new Error('Не задан ключ DaData. Откройте меню «Итоги» → «Ключ DaData» и сохраните ключ.');
      const response = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'Authorization': 'Token ' + apiKey },
        body: JSON.stringify(body),
        signal: controller.signal
      });
      if (!response.ok) {
        let detail = '';
        try { const j = await response.json(); detail = j.message || j.detail || ''; } catch (_) {}
        throw new Error('DaData HTTP ' + response.status + (detail ? ': ' + detail : ''));
      }
      const data = await response.json();
      if (seq !== requestSeq) return;
      let items = Array.isArray(data.suggestions) ? data.suggestions : [];
      // Если ограничение по заданному городу дало пустой ответ, повторяем без него.
      if (!items.length && city && seq === requestSeq) {
        const r2 = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'Authorization': 'Token ' + getDaDataApiKey() },
          body: JSON.stringify({ query, count: 8, language: 'ru', locations: [{ country: '*' }] }),
          signal: controller.signal
        });
        if (r2.ok) { const j2 = await r2.json(); items = Array.isArray(j2.suggestions) ? j2.suggestions : []; }
      }
      // Если пользователь задал свой город, не показываем одноимённые улицы из других
      // населённых пунктов округа. Сначала строго предпочитаем совпадение города,
      // а записи с явно указанным другим населённым пунктом исключаем.
      if (city && Array.isArray(items) && items.length) {
        const normLocality = v => String(v || '').toLocaleLowerCase('ru').replace(/ё/g, 'е').replace(/\s+/g, ' ').trim();
        const wanted = normLocality(city);
        const localityFields = d => [d.city, d.settlement, d.settlement_with_type, d.city_with_type, d.region_with_type]
          .filter(Boolean).map(normLocality);
        const scored = items.map((it, index) => {
          const d = it.data || {};
          const fields = localityFields(d);
          const exactCity = fields.some(v => v === wanted || v === 'г ' + wanted || v === 'город ' + wanted || v === 'г. ' + wanted);
          const mentionsOther = fields.some(v => v && !(
            v === wanted || v === 'г ' + wanted || v === 'город ' + wanted || v === 'г. ' + wanted ||
            v.startsWith(wanted + ',') || v.startsWith('г ' + wanted + ',') || v.startsWith('город ' + wanted + ',')
          ));
          // DaData может указывать область/район в дополнительных полях — они не должны
          // сами по себе считаться населённым пунктом. Для решения используем именно city/settlement.
          const loc = [d.city, d.settlement, d.settlement_with_type, d.city_with_type].filter(Boolean).map(normLocality);
          const isExact = loc.some(v => v === wanted || v === 'г ' + wanted || v === 'город ' + wanted || v === 'г. ' + wanted);
          const isClearlyOther = loc.length > 0 && !isExact && !loc.some(v => v.includes(wanted));
          return { it, index, isExact, isClearlyOther, score: isExact ? 0 : (isClearlyOther ? 2 : 1) };
        });
        const exact = scored.filter(x => x.isExact);
        // Если есть адреса именно в выбранном городе — показываем только их.
        // Иначе убираем только результаты, у которых явно указан другой населённый пункт.
        const kept = exact.length ? exact : scored.filter(x => !x.isClearlyOther);
        items = (kept.length ? kept : scored).sort((a, b) => a.score - b.score || a.index - b.index).map(x => x.it);
      }
      if (seq === requestSeq) {
        window.__addrDiag = { t: Date.now(), q: query, street: true, src: 'DaData API', n: items.length, err: '', cityFilter: city || '' };
        show(items);
      }
    } catch (err) {
      if (err && err.name === 'AbortError') return;
      if (seq !== requestSeq) return;
      const dadataError = String((err && err.message) || err).slice(0, 160);
      console.warn('DaData address search failed; trying fallback geocoders:', err);
      // Резервный поиск: если соединение с DaData закрыто сетью/браузером, пробуем Photon (OpenStreetMap) с приоритетом русского языка.
      // Это позволяет продолжать искать адреса без ожидания восстановления DaData.
      let fallbackItems = [];
      try {
        const fallbackQuery = [city, query].filter(Boolean).join(' ');
        const u = new URL('https://photon.komoot.io/api/');
        u.searchParams.set('q', fallbackQuery);
        u.searchParams.set('limit', '8');
        u.searchParams.set('lang', 'ru');
        const r = await fetch(u.toString(), { signal: controller.signal });
        if (r.ok) {
          const j = await r.json();
          fallbackItems = (j.features || []).map(f => {
            const p = f.properties || {}, c = f.geometry && f.geometry.coordinates || [];
            const street = p.street || p.name || '';
            const house = p.housenumber || '';
            const place = [p.postcode, p.city || p.town || p.village || p.locality, street, house].filter(Boolean).join(', ');
            const value = place || p.name || p.street || '';
            if (!value) return null;
            return { value, data: { postal_code: p.postcode || '', region: p.state || '', city_district: p.district || p.suburb || '', street, house, geo_lat: c.length > 1 ? String(c[1]) : '', geo_lon: c.length > 1 ? String(c[0]) : '' } };
          }).filter(Boolean);
        }
      } catch (fallbackError) {
        console.warn('Photon fallback failed:', fallbackError);
      }
      if (!fallbackItems.length) {
        try {
          const u = new URL('https://nominatim.openstreetmap.org/search');
          u.searchParams.set('format', 'jsonv2');
          u.searchParams.set('addressdetails', '1');
          u.searchParams.set('limit', '8');
          u.searchParams.set('accept-language', 'ru');
          u.searchParams.set('q', [city, query].filter(Boolean).join(', '));
          const r = await fetch(u.toString(), { signal: controller.signal, headers: { 'Accept': 'application/json' } });
          if (r.ok) {
            const j = await r.json();
            fallbackItems = (j || []).map(x => {
              const a = x.address || {};
              return { value: x.display_name || '', data: { postal_code: a.postcode || '', region: a.state || '', city_district: a.suburb || a.city_district || '', street: a.road || '', house: a.house_number || '', geo_lat: x.lat || '', geo_lon: x.lon || '' } };
            }).filter(x => x.value);
          }
        } catch (fallbackError) {
          console.warn('Nominatim fallback failed:', fallbackError);
        }
