    bd.addEventListener('click', function (e) { if (e.target === bd) close(false); });   // тап по затемнению = отмена
    ['touchend', 'click'].forEach(function (t) { ta.addEventListener(t, function () { if (document.activeElement !== ta) { try { ta.focus({ preventScroll: true }); } catch (e) {} } }); });
  }
