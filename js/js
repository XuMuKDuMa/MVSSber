/* ═══════════════════════════════════════════════
   ИИ-помощник: анализ ТОЛЬКО километража и расходов на бензин
   (считает по правилам прямо в приложении, внешний ИИ и интернет не нужны)
   ═══════════════════════════════════════════════ */
function kmFuelAnalysisLines() {
  const now = new Date();
  const prevRef = new Date(now.getFullYear(), now.getMonth() - 1, 15);
  const cur = kmMonthData(now), prev = kmMonthData(prevRef);
  const f = fuelLoad();
  const fuelOk = f.cons > 0 && f.price > 0;
  const km1 = v => kmFmt(v);                                         // «12,3 км»
  const pctTxt = (a, b) => b > 0 ? ((a - b) / b * 100) : null;
  const sgn = v => (v > 0 ? '+' : '') + Math.round(v) + '%';
  const monthName = now.toLocaleDateString('ru-RU', { month: 'long', year: 'numeric' });
  const L = [];
  L.push('🚗 АНАЛИЗ КИЛОМЕТРАЖА И БЕНЗИНА · ' + monthName.toUpperCase());
  L.push('');
  const rows = cur.rows;
  if (!rows.length) {
    L.push('Пока нет данных за этот месяц.');
    L.push('');
    L.push('💡 Километраж считается по адресам с «Готово» и по тем, где нажато «Маршрут». Начни работать — и анализ появится.');
    return L;
  }
  const n = rows.length, total = cur.total, avg = total / n;
  const sorted = rows.slice().sort((a, b) => b.km - a.km);
  const maxD = sorted[0], minD = sorted[sorted.length - 1];
  const dayLbl = r => r.date.slice(0, 5);
  L.push('📏 КИЛОМЕТРАЖ');
  L.push('Всего: ' + km1(total) + ' за ' + n + ' ' + (n === 1 ? 'день' : (n < 5 ? 'дня' : 'дней')));
  L.push('В среднем: ' + km1(avg) + ' в день');
  if (n > 1) {
    L.push('Самый длинный: ' + dayLbl(maxD) + ' — ' + km1(maxD.km));
    L.push('Самый короткий: ' + dayLbl(minD) + ' — ' + km1(minD.km));
  }
  const stops = rows.reduce((a, r) => a + (r.manual ? 0 : (r.stops || 0)), 0);
  const kmAuto = rows.reduce((a, r) => a + (r.manual ? 0 : (r.km || 0)), 0);
  const perStop = stops > 0 ? kmAuto / stops : null;
  if (perStop != null) L.push('На 1 адрес: ' + km1(perStop) + ' (' + stops + ' адр.)');
  const pTot = prev.total, pn = prev.rows.length;
  if (pn > 0) {
    const dTot = pctTxt(avg, pTot / pn);
    L.push('К прошлому месяцу: ' + (dTot == null ? '—' : sgn(dTot) + ' по среднему в день') + ' (было ' + km1(pTot / pn) + ' в день)');
  }
  // прогноз к концу месяца
  const wd = getWorkingDaysStats();
  const left = wd.remaining;
  const projKm = total + avg * left;
  if (left > 0 && n >= 3) L.push('Прогноз к концу месяца: ≈ ' + km1(projKm) + ' (ещё ' + left + ' раб. дн.)');

  L.push('');
  L.push('⛽ БЕНЗИН');
  if (!fuelOk) {
    L.push('Расход и цена не заданы. Укажи их в меню ⋮ → «⛽ Расход бензина» — тогда посчитаю затраты.');
  } else {
    const liters = total * f.cons / 100, cost = liters * f.price;
    L.push('Потрачено: ' + fuelMoney(cost) + ' (' + fuelLiters(liters) + ')');
    L.push('В среднем: ' + fuelMoney(cost / n) + ' в день');
    L.push('1 км обходится в ' + (f.cons * f.price / 100).toFixed(2).replace('.', ',') + ' ₽ (' + String(f.cons).replace('.', ',') + ' л/100 км × ' + String(f.price).replace('.', ',') + ' ₽)');
    if (n > 1) L.push('Самый дорогой день: ' + dayLbl(maxD) + ' — ' + fuelMoney(maxD.km * f.cons / 100 * f.price));
    if (left > 0 && n >= 3) L.push('Прогноз к концу месяца: ≈ ' + fuelMoney(projKm * f.cons / 100 * f.price));
    if (pn > 0) {
      const pCost = prev.total * f.cons / 100 * f.price;
      const d = pctTxt(cost / n, pCost / pn);
      if (d != null) L.push('К прошлому месяцу: ' + sgn(d) + ' по затратам в день (было ' + fuelMoney(pCost / pn) + ')');
    }
  }

  // наблюдения и советы — только про километраж и бензин
  const tips = [];
  const pts = kmLoadPoints();
  if (!pts.start) tips.push('Не задана начальная точка — километраж считается только между адресами и занижен. Задай её в меню ⋮ → «🚗 Начальная и конечная точка».');
  const missing = rows.filter(r => r.skipped > 0).length;
  if (missing > 0) tips.push('В ' + missing + ' ' + (missing === 1 ? 'дне' : 'днях') + ' часть адресов не нашлась на карте — километраж за эти дни занижен. Укажи координаты вручную (📍 на карточке).');
  const approx = rows.filter(r => r.approx && !r.manual).length;
  if (approx > 0) tips.push(approx + ' ' + (approx === 1 ? 'день посчитан' : 'дней посчитано') + ' приблизительно (≈, без сети). Нажми «↻ Пересчитать сегодня», когда будет интернет.');
  const manual = rows.filter(r => r.manual).length;
  if (manual > 0) tips.push(manual + ' ' + (manual === 1 ? 'день введён' : 'дней введено') + ' вручную — в расчёт «километров на 1 адрес» такие дни не входят.');
  if (n >= 3 && maxD.km > avg * 1.5) tips.push('День ' + dayLbl(maxD) + ' (' + km1(maxD.km) + ') на ' + Math.round((maxD.km / avg - 1) * 100) + '% длиннее среднего. Посмотри, не было ли лишних переездов, и в такие дни группируй адреса по районам.');
  if (perStop != null && pn > 0) {
    const pStops = prev.rows.reduce((a, r) => a + (r.manual ? 0 : (r.stops || 0)), 0);
    const pKmAuto = prev.rows.reduce((a, r) => a + (r.manual ? 0 : (r.km || 0)), 0);
    if (pStops > 0) {
      const d = pctTxt(perStop, pKmAuto / pStops);
      if (d != null && d > 20) tips.push('На 1 адрес приходится на ' + Math.round(d) + '% больше километров, чем в прошлом месяце — маршруты стали «рваными». Проверь порядок объезда.');
      else if (d != null && d < -15) tips.push('Километров на 1 адрес стало меньше на ' + Math.round(-d) + '% — маршруты стали компактнее, так держать.');
    }
  }
  if (n < 3) tips.push('Данных пока мало (' + n + ' ' + (n === 1 ? 'день' : 'дня') + ') — выводы будут точнее через несколько рабочих дней.');
  L.push('');
  L.push('💡 НАБЛЮДЕНИЯ');
  if (!tips.length) L.push('Всё ровно: резких скачков по километражу и расходам не вижу.');
  tips.forEach(t => L.push('• ' + t));
  return L;
}

function forecastBlockHtml(o) {
  const plan = o.plan, monthUP = o.monthUP, remains = o.remains, wd = o.wd;
  if (!(plan > 0)) return '';
  const elapsedWorkdays = wd.past + wd.days.filter(d => d.working && d.isToday).length;
  const analysisReady = elapsedWorkdays >= 5;
  const history = loadHistory1();
  const monthEntries = Object.keys(history).map(key => {
    const parts = key.split('.').map(Number);
    if (parts.length !== 3 || parts[1] !== new Date().getMonth() + 1 || parts[2] !== new Date().getFullYear()) return null;
    return { key, date: new Date(parts[2], parts[1] - 1, parts[0]), up: Number(history[key].up || 0) };
  }).filter(Boolean).sort((a,b) => a.date - b.date);
  const absenceMap = loadCalendarAbsences();
  let workdayIndex = 0, upAtMilestone = 0;
  const milestones = [];
  const dayUpByKey = {};
  monthEntries.forEach(e => { dayUpByKey[calendarDateKey(e.date)] = e.up; });
  const today = new Date();
  for (let d = 1; d <= today.getDate(); d++) {
    const date = new Date(today.getFullYear(), today.getMonth(), d);
    if (!isWorkingDay(date) || absenceMap[calendarDateKey(date)]) continue;
    workdayIndex++;
    upAtMilestone += dayUpByKey[calendarDateKey(date)] || 0;
    if (workdayIndex % 5 === 0) milestones.push({ days: workdayIndex, up: upAtMilestone, avg: upAtMilestone / workdayIndex });
  }
  const latestMilestone = milestones.length ? milestones[milestones.length - 1] : null;
  const fmt = (v, d) => (Math.round(v * Math.pow(10, d)) / Math.pow(10, d)).toFixed(d).replace('.', ',');
  const row = (name, val, sub, color) => `<div class="row" style="justify-content:space-between;align-items:center;">
      <div class="name" style="flex:1">${name}</div>
      <div style="text-align:right;"><div style="font-weight:700;font-size:14px;${color ? 'color:' + color + ';' : ''}">${val}</div>${sub ? '<div style="font-weight:600;color:#95a5a6;font-size:11px;margin-top:2px;">' + sub + '</div>' : ''}</div>
    </div>`;
  let body = '';
  if (remains <= 0) {
    body = row('План выполнен', '🎉', 'сверх плана ' + fmt(-remains, 2) + ' УП', '#27ae60');
  } else {
    const left = wd.remaining;
    const need = left > 0 ? remains / left : remains;
    const pace = o.daysWorked > 0 ? monthUP / o.daysWorked : 0;
    const projected = monthUP + pace * left;
    const gap = plan - projected;
    // средний УП на одну продажу — по продажам этого месяца (иначе по средним коэффициентам)
    const sales = getSalesForMonth(o.year, o.month);
    const upByName = {};
    SECTIONS1.forEach(sec => (sec.items || []).forEach(it => { if (it.type !== 'meeting' && it.type !== 'biz') upByName[it.name] = it.up; }));
    let upSum = 0, cnt = 0;
    (sales.entries || []).forEach(e => { const up = upByName[e.name]; if (up != null) { upSum += up * e.count; cnt += e.count; } });
    let avgUp = cnt > 0 ? upSum / cnt : 0, avgNote = 'по твоим продажам';
    if (!avgUp) { avgUp = ANALYSIS_SALES.reduce((a, s) => a + s.coef, 0) / ANALYSIS_SALES.length; avgNote = 'по средним коэффициентам'; }
    const salesTotal = sales.totalSum || 0;
    const meetPerSale = salesTotal > 0 && o.sumMeetings > 0 ? o.sumMeetings / salesTotal : null;
    const salesNeed = Math.ceil(remains / avgUp);
    body = row('Осталось до плана', fmt(remains, 2) + ' УП', left + ' раб. дн. впереди')
      + row('Нужно в день', fmt(need, 2) + ' УП', pace > 0 ? 'сейчас у тебя ' + fmt(pace, 2) + ' в день' : '', need > pace && pace > 0 ? '#e67e22' : '#27ae60')
      + (pace > 0 ? row('Прогноз к концу месяца', fmt(projected, 1) + ' УП', gap > 0 ? 'не хватает ' + fmt(gap, 1) + ' УП' : 'план будет выполнен ✓', gap > 0 ? '#e74c3c' : '#27ae60') : '')
      + row('Встреч на 1 продажу', meetPerSale ? fmt(meetPerSale, 1) : '—', meetPerSale ? o.sumMeetings + ' встреч · ' + salesTotal + ' продаж' : 'пока нет продаж за месяц')
      + row('Продаж до плана', '≈ ' + salesNeed, 'в среднем ' + fmt(avgUp, 2) + ' УП на продажу (' + avgNote + ')', '#3949ab')
      + (meetPerSale ? row('Встреч для этих продаж', '≈ ' + Math.ceil(salesNeed * meetPerSale), 'при твоей конверсии') : '');
  }
  const analysisHtml = !analysisReady
