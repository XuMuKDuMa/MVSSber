      </div>`;
  }
  return `<div class="section" id="fuelSection">
    <div class="section-title" id="fuelToggle" style="background:#e67e22;cursor:pointer;display:flex;justify-content:space-between;align-items:center;">
      <span>⛽ Бензин за месяц${ok && days.length ? ' · ' + fuelMoney(sumCost) : ''}</span>
