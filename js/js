function fuelLoad() {
  try {
    const p = JSON.parse(localStorage.getItem('fuel_settings') || '{}') || {};
    return { cons: parseFloat(p.cons) || 0, price: parseFloat(p.price) || 0 };
  } catch (e) { return { cons: 0, price: 0 }; }
}
function fuelMoney(v) { return Math.round(v).toLocaleString('ru-RU') + ' ₽'; }
function fuelLiters(v) { return (Math.round(v * 10) / 10).toFixed(1).replace('.', ',') + ' л'; }
function fuelChartSvg(days) {
  const bw = 34, gap = 10, H = 190, top = 24, bottom = 24;
  const W = Math.max(days.length * (bw + gap) + gap, 280);
  const max = Math.max(1, ...days.map(d => d.cost));
  let bars = '';
  days.forEach((d, i) => {
    const h = Math.max(3, (d.cost / max) * (H - top - bottom));
    const x = gap + i * (bw + gap);
    const y = H - bottom - h;
    bars += `<rect x="${x}" y="${y}" width="${bw}" height="${h}" rx="7" fill="url(#fuelGrad)"/>
      <text x="${x + bw / 2}" y="${y - 6}" text-anchor="middle" font-size="10" font-weight="700" fill="#e67e22">${Math.round(d.cost)}</text>
      <text x="${x + bw / 2}" y="${H - 8}" text-anchor="middle" font-size="11" fill="#95a5a6">${d.day}</text>`;
  });
  return `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" xmlns="http://www.w3.org/2000/svg" style="display:block;">
    <defs><linearGradient id="fuelGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#f5b041"/><stop offset="1" stop-color="#e67e22"/></linearGradient></defs>
    <line x1="0" y1="${H - bottom}" x2="${W}" y2="${H - bottom}" stroke="#95a5a6" stroke-opacity=".35"/>
    ${bars}</svg>`;
}
function fuelSectionHtml() {
