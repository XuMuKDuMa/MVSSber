// Получение геолокации пользователя
function getUserLocation() {
  // ─── Если сохранён город — НЕ центрируем по GPS ───
  const savedCity = getMyCity();
  if (savedCity) {
    // console.log('📍 Есть город:', savedCity, '— GPS игнорируется');  /* отладочный вывод отключён */
    updateMapCityLabel(savedCity);
    return;
  }

  if (!navigator.geolocation) {
    fetch('https://ipapi.co/json/')
      .then(r => r.json())
      .then(data => {
        if (data.latitude && data.longitude) {
          userLocation = [data.latitude, data.longitude];
          if (map) map.setView(userLocation, 13);
          updateMapCityLabel(data.city);
        }
      })
      .catch(() => { updateMapCityLabel(); });
    return;
  }
  
  navigator.geolocation.getCurrentPosition(
    (pos) => {
      userLocation = [pos.coords.latitude, pos.coords.longitude];
      // ─── Сохраняем для кнопки "Моё местоположение", но НЕ центрируем ───
      updateMapCityLabel();
    },
    (err) => {
      console.warn('GPS denied, fallback to IP:', err);
      fetch('https://ipapi.co/json/')
        .then(r => r.json())
        .then(data => {
          if (data.latitude && data.longitude) {
            userLocation = [data.latitude, data.longitude];
            updateMapCityLabel(data.city);
          }
        })
        .catch(() => { updateMapCityLabel(); });
    },
    { enableHighAccuracy: true, timeout: 5000, maximumAge: 60000 }
  );
}

// Обновление подписи города
async function geocodeAddress(address, noCity) {
  let cleanAddr = noCity ? String(address || '').trim() : applyCity(address).trim();
  if (!cleanAddr) return null;
  
  const city = noCity ? '' : getMyCity();
  if (city && !cleanAddr.toLowerCase().includes(city.toLowerCase())) {
    cleanAddr = city + ', ' + cleanAddr;
  }
  
  if (Object.prototype.hasOwnProperty.call(mapGeocache, cleanAddr)) {
    return mapGeocache[cleanAddr]; // может быть null - уже пытались найти и не вышло
  }

  let reached = false;   // хоть один сервис реально ответил?

  // ─── Nominatim (OpenStreetMap) — точнее для России ───
  try {
    const url = `https://nominatim.openstreetmap.org/search?` +
                `q=${encodeURIComponent(cleanAddr)}` +
                `&format=json&limit=5&accept-language=ru` +
                `&countrycodes=ru` +                    // ← только Россия
                `&addressdetails=1`;
    
    const response = await fetch(url, {
      headers: { 'User-Agent': 'MVS-Reports-App/1.0' }
    });
    const data = await response.json();
    reached = true;

    if (data && data.length > 0) {
      // Если указан «Мой город» — берём результат, который реально в этом городе
      let best = data[0];
      if (city) {
        const cl = city.toLowerCase();
        const matched = data.find(item => {
          const a = item.address || {};
          const ic = (a.city || a.town || a.village || a.municipality || a.county || '').toLowerCase();
          return ic && (ic.includes(cl) || cl.includes(ic));
        });
        if (matched) best = matched;
      }
      const coords = [parseFloat(best.lat), parseFloat(best.lon)];
      mapGeocache[cleanAddr] = coords;
      saveGeocache();
      // console.log('✅ Nominatim:', cleanAddr, '→', coords);  /* отладочный вывод отключён */
      return coords;
    }
  } catch (e) {
    console.warn('Nominatim error:', e);
  }

  // ─── Fallback: photon.komoot.io (если Nominatim не ответил) ───
  try {
    const response = await fetch(
      `https://photon.komoot.io/api/?q=${encodeURIComponent(cleanAddr)}&limit=1&lang=ru`
    );
    const data = await response.json();
    reached = true;

    if (data && data.features && data.features.length > 0) {
      const geom = data.features[0].geometry;
      const coords = [geom.coordinates[1], geom.coordinates[0]];
      
      // ─── Проверка: координаты в России? ───
      // Россия: широта 41–82, долгота 19–180 (и -180 до -169 для Калининграда)
      const [lat, lon] = coords;
      const inRussia = lat >= 41 && lat <= 82 && (
        (lon >= 19 && lon <= 180) || (lon >= -180 && lon <= -169)
      );
      
      if (!inRussia) {
        console.warn('⚠️ Photon вернул координаты вне России:', coords);
        return null;   // ← не сохраняем
      }
      
      mapGeocache[cleanAddr] = coords;
      saveGeocache();
      return coords;
    }
  } catch (e) {
    console.warn('Photon error:', e);
  }

  // Кэшируем «не найден» только если сервисы реально ответили.
  // Если связи не было — не запоминаем, чтобы адрес нашёлся позже.
  if (reached) {
    mapGeocache[cleanAddr] = null;
    saveGeocache();
  }
  return null;
}
function saveGeocache() {
  try {
    localStorage.setItem('map_geocache', JSON.stringify(mapGeocache));
  } catch (e) {}
}

function loadGeocache() {
  try {
    const saved = localStorage.getItem('map_geocache');
    if (saved) mapGeocache = JSON.parse(saved);
  } catch (e) {}
}
// ─── Обновление надписи города на карте ───
function updateMapCityLabel(cityName) {
  const label = document.getElementById('mapCityLabel');
  if (!label) return;

  // Приоритет 1: сохранённый город из поля «Мой город»
  const savedCity = getMyCity();
  if (savedCity) {
    label.textContent = savedCity;
    return;
  }

  // Приоритет 2: переданный город
  if (cityName) {
    label.textContent = cityName;
    return;
  }

  // Приоритет 3: reverse geocode по GPS
  if (userLocation) {
    fetch(`https://nominatim.openstreetmap.org/reverse?lat=${userLocation[0]}&lon=${userLocation[1]}&format=json&accept-language=ru`)
      .then(r => r.json())
      .then(data => {
        const city = data.address?.city || data.address?.town || data.address?.village || 'Ваш город';
        label.textContent = city;
      })
      .catch(() => { label.textContent = 'Ваш город'; });
  } else {
    label.textContent = 'Определяем город…';
  }
}
