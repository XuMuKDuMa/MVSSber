// Опрашиваем все сервисы; после первого успешного ответа ждём остальных ещё 2.5 с
function vpnCollect() {
  return new Promise(resolve => {
    const results = [];
    let left = VPN_APIS.length, timer = null, done = false;
    const finish = () => { if (done) return; done = true; clearTimeout(timer); resolve(results.slice()); };
    VPN_APIS.forEach(a => {
      const host = new URL(a.url).hostname.replace(/^(api|get)\./, '');
      const js = !!a.jsonp;
      (js ? httpJsonp(a.url, 9000) : httpGetJson(a.url, 9000)).then(d => {
        const m = a.map(d);
        if (m) {
          results.push({ host, js, ok: true, country: String(m.country).toUpperCase(), org: String(m.org || '').trim() });
          if (!timer) timer = setTimeout(finish, 2500);
        } else {
          results.push({ host, js, ok: false, err: 'пустой ответ' });
        }
      }, e => {
        results.push({ host, js, ok: false, err: String((e && e.message) || e).slice(0, 24) });
      }).then(() => { if (--left === 0) finish(); });
    });
  });
}

// force = true — проверить сейчас, игнорируя «свежий» результат (кнопка в меню)
async function checkVpnAndWarn(force) {
