function buildRouteCard(item, timeId, timeLabel, opts) {
  const card = document.createElement('div');
  card.__routeItem = item;
  card.className = 'route-card';
  if (timeId) card.classList.add('route-slot-' + timeId);
  if (item.status === 'wait') card.classList.add('status-wait');
  if (item.status === 'done') card.classList.add('status-done');
  if (item.status === 'perenos') card.classList.add('status-perenos');
  if (item.status === 'ndz') card.classList.add('status-ndz');
  if (item.status === 'done' || item.status === 'perenos') card.classList.add('route-card-compact');
  
   // Короткие карточки: первый тап раскрывает карточку, не открывая карту.
  // uiExpanded выставляется при смене типа встречи и B2C/B2B — тогда после перерисовки карточка остаётся открытой.
  // Сворачивается только при выборе статуса (там uiExpanded = false).
  const asSheet = !!(opts && opts.sheet);   // экземпляр для выезжающей панели — всегда раскрыт
  const isCollapsed = !asSheet && !item.startedAt && (!item.uiExpanded || window.__mvsSheetItem === item) && !!String(item.addrDisplay || item.addr || '').trim();
  if (isCollapsed) card.classList.add('collapsed');
    // Если встреча в процессе — добавляем класс "живой"
  if (item.startedAt) card.classList.add('route-card-live');



    // ─── Тап по обычной карточке → открыть на карте ───
  card.addEventListener('click', (e) => {
    const ignoreSelectors = [
      'input', 'textarea', 'button', 'select',
      '.status-badge', '.route-start-btn', '.route-live',
      '.route-mic-inline', '.route-note-mic', '.route-coords-btn',
      '.route-side-btn', '.route-status-btn', '.route-add-btn',
      '.voice-panel', '.vp-btn', '.vp-audio',
      '.status-menu', '.status-overlay', '.route-note-wrap',
    ];
    if (ignoreSelectors.some(sel => e.target.closest(sel))) return;

    if (card.classList.contains('collapsed')) {
      // Карточка «выезжает» справа в отдельной панели (можно выключить в «Настройках»)
      if (window.mvsCardSheetEnabled && window.mvsCardSheetEnabled() && window.mvsOpenCardSheet) {
        vibro(12);
        window.mvsOpenCardSheet(item, timeId, timeLabel);
        return;
      }
      const parent = card.parentElement;
      if (parent) parent.querySelectorAll('.route-card:not(.route-card-live)').forEach(other => {
        if (other !== card) {
          other.classList.add('collapsed');
          if (other.__routeItem) other.__routeItem.uiExpanded = false;
        }
      });
      card.classList.remove('collapsed');
      item.uiExpanded = true;
      vibro(12);   // вибро-отклик на открытие карточки
      try { saveRouteState(routeState); } catch (err) {}
      return;
    }

    const addr = (item.addr || '').trim();
    if (!addr) return;
    vibro(10);
    openMapForAddress(addr);
  });
  const topRow = document.createElement('div');
topRow.className = 'route-top-row';

