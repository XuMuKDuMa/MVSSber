function getTodayQuote() {
  const now = new Date();
  const dayOfWeek = now.getDay();  // 0 = Вс, 1 = Пн, ..., 6 = Сб

  // Берём список цитат для сегодняшнего дня недели
  const quotesForDay = DAILY_QUOTES[dayOfWeek] || DAILY_QUOTES[1];

  // Внутри дня — выбираем по дате (чтобы каждый день была новая)
  const start = new Date(2024, 0, 1);
  const diffDays = Math.floor((now - start) / (1000 * 60 * 60 * 24));
  const index = Math.abs(diffDays) % quotesForDay.length;

  return quotesForDay[index];
}

