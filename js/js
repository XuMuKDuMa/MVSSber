          const u = new URL('https://nominatim.openstreetmap.org/search');
          u.searchParams.set('format', 'jsonv2');
          u.searchParams.set('addressdetails', '1');
          u.searchParams.set('limit', '8');
          u.searchParams.set('accept-language', 'ru');
          u.searchParams.set('q', [city, query].filter(Boolean).join(', '));
          const r = await fetch(u.toString(), { signal: controller.signal, headers: { 'Accept': 'application/json' } });
          if (r.ok) {
            const j = await r.json();
            fallbackItems = (j || []).map(x => {
              const a = x.address || {};
              return { value: x.display_name || '', data: { postal_code: a.postcode || '', region: a.state || '', city_district: a.suburb || a.city_district || '', street: a.road || '', house: a.house_number || '', geo_lat: x.lat || '', geo_lon: x.lon || '' } };
            }).filter(x => x.value);
          }
        } catch (fallbackError) {
          console.warn('Nominatim fallback failed:', fallbackError);
        }
      }
      if (seq === requestSeq && fallbackItems.length) {
        window.__addrDiag = { t: Date.now(), q: query, street: true, src: 'OpenStreetMap fallback', n: fallbackItems.length, err: dadataError };
        show(fallbackItems);
      } else if (seq === requestSeq) {
        window.__addrDiag = { t: Date.now(), q: query, street: true, src: 'DaData + OpenStreetMap', n: 0, err: dadataError };
        closeList();
        if (typeof showToast === 'function') showToast('Поиск адресов недоступен: DaData не отвечает, резервный поиск тоже не вернул адреса. Адрес можно ввести вручную.');
      }
    }
  }
