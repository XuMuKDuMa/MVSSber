    b.type = 'button';
    b.className = 'route-fe-btn route-fe-' + kind;
    b.innerHTML = '<span class="fe-ic">' + icon + '</span><span class="fe-lb">' + label + '</span>' + (kind === 'reason' ? '<span class="fe-chev" aria-hidden="true">▾</span>' : '');
    ['pointerdown', 'mousedown', 'touchstart'].forEach(t => b.addEventListener(t, e => e.stopPropagation(), { passive: true }));
    b.addEventListener('click', e => {
      e.stopPropagation(); e.preventDefault();
      // причина пуста — раскрываем список причин; причина есть — открываем окно редактирования
      if (kind === 'reason' && !(item.nonDeliveryReason || '').trim() && reasonAcc) { toggleReasonAcc(); return; }
      target.click();
    });
    return b;
  }
  noteBtn = mk('note', '📝', 'Заметка', noteInput);
  reasonBtn = mk('reason', '⚠️', 'Причина недоставки', reasonInput);
  // «Заметка» — сразу под полем адреса
  const noteRow = document.createElement('div');
  noteRow.className = 'route-fe-row route-fe-row-note';
  noteRow.appendChild(noteBtn);
  noteWrap.appendChild(noteRow);
  // «Причина» — в самом низу карточки
  const reasonRow = document.createElement('div');
  reasonRow.className = 'route-fe-row route-fe-row-reason';
  reasonRow.appendChild(reasonBtn);
  reasonWrap.insertBefore(reasonRow, reasonInput);
  // Аккордеон причин: появляется под кнопкой, пока причина не указана; тап по строке сразу записывает причину
  reasonAcc = document.createElement('div');
  reasonAcc.className = 'route-reason-acc';
  reasonAcc.hidden = true;
  (window.mvsReasonsAll || []).forEach(text => {
    const o = document.createElement('button');
    o.type = 'button'; o.className = 'route-reason-opt'; o.textContent = text;
    ['pointerdown', 'mousedown', 'touchstart'].forEach(t => o.addEventListener(t, e => e.stopPropagation(), { passive: true }));
    o.addEventListener('click', e => {
      e.stopPropagation(); e.preventDefault();
      reasonInput.value = text;
      saveNonDeliveryReason(false); saveNonDeliveryReason(true);
      refreshFeBtns();
      try { vibro(12); } catch (er) {}
    });
    reasonAcc.appendChild(o);
  });
  const other = document.createElement('button');
  other.type = 'button'; other.className = 'route-reason-opt other'; other.textContent = '✏️ Другая причина…';
  ['pointerdown', 'mousedown', 'touchstart'].forEach(t => other.addEventListener(t, e => e.stopPropagation(), { passive: true }));
  other.addEventListener('click', e => { e.stopPropagation(); e.preventDefault(); toggleReasonAcc(false); reasonInput.click(); });
  reasonAcc.appendChild(other);
  reasonWrap.insertBefore(reasonAcc, reasonInput);
  // Поля полностью убираем (inline !important перебивает любые стили приложения)
  [noteInput, reasonInput].forEach(el => {
    el.classList.add('route-fe-hidden');
    el.style.setProperty('display', 'none', 'important');
  });
  refreshFeBtns();
})();
card.appendChild(statusLine);
card.appendChild(reasonWrap);
card.appendChild(buildCardProducts(asSheet));   // аккордеон «Список продуктов» (те же продукты и счётчики, что в «Сегодня»)

  // Авто-высота для textarea — после вставки в DOM
  requestAnimationFrame(() => autoGrow(addrInput));
  setTimeout(() => autoGrow(addrInput), 100);
  setTimeout(() => autoGrow(addrInput), 300);
  // После первого касания повторно сохраняем фокус на поле, если браузер его потерял
  // из-за перестройки карточки; повторный focus не запускается при обычном рендере.
  addrInput.addEventListener('focus', () => {
    requestAnimationFrame(() => {
      if (document.activeElement === addrInput) autoGrow(addrInput);
    });
  });
    addrInput.addEventListener('change', () => autoGrow(addrInput));
  addrInput.addEventListener('blur', () => autoGrow(addrInput));

  return card;
}

// ─── Аккордеон «Список продуктов» внизу большой карточки ───
// Те же продукты и те же счётчики, что в разделе «Сегодня» (SECTIONS1, getCount1/setCount1).
// Строится при первом раскрытии, чтобы не нагружать список карточек.
function buildCardProducts(asSheet) {
  const wrap = document.createElement('div');
  wrap.className = 'route-products';
  const btn = document.createElement('button');
  btn.type = 'button';
  btn.className = 'products-toggle-btn route-products-btn';
  btn.setAttribute('aria-expanded', 'false');
  btn.innerHTML = '<span class="ptb-text">Список продуктов</span><span class="ptb-icon">▼</span>';
  const body = document.createElement('div');
  body.className = 'products-wrap route-products-body';
  wrap.appendChild(btn);
  wrap.appendChild(body);
  // клики внутри аккордеона не должны открывать карту (тап по раскрытой карточке ведёт на карту)
  [wrap].forEach(el => {
    el.addEventListener('click', e => e.stopPropagation());
    ['touchstart', 'mousedown'].forEach(t => el.addEventListener(t, e => e.stopPropagation(), { passive: true }));
  });

  const rows = [];   // { id, valueEl, badgeUpdate }
  function build() {
    if (typeof SECTIONS1 === 'undefined') return;
    SECTIONS1.forEach(section => {
      const items = (section.items || []).filter(i => i && i.type !== 'meeting' && i.type !== 'biz');
      if (!items.length || section.title === 'Встречи' || section.title === 'Бизнес') return;
      const sec = document.createElement('div');
      sec.className = 'section';
      sec.dataset.sectionTitle = section.title;
      const title = document.createElement('div');
      title.className = 'section-title ' + (section.color || '');
      title.style.cssText = 'cursor:pointer;display:flex;justify-content:space-between;align-items:center;user-select:none;';
      const label = document.createElement('span');
      const arrow = document.createElement('span');
      arrow.className = 'section-arrow';
      arrow.style.cssText = 'font-size:12px;opacity:.85;transition:transform .2s;';
      arrow.textContent = '▼';
      title.appendChild(label); title.appendChild(arrow);
      const sbody = document.createElement('div');
      sbody.className = 'section-body';
      sbody.style.display = 'none';
      function updBadge() {
        let n = 0; items.forEach(i => { n += getCount1(i.id); });
        label.innerHTML = section.title + (n > 0 ? `<span style="font-size:11px;font-weight:700;background:rgba(255,255,255,0.25);padding:2px 8px;border-radius:10px;margin-left:8px;">${n}</span>` : '');
      }
      updBadge();
      items.forEach(item => {
        const row = document.createElement('div');
        row.className = 'row';
        row.dataset.id = item.id;
        const cnt = getCount1(item.id);
        row.innerHTML = `<div class="name"><span class="name-text">${item.name}</span><span class="coef">${item.up}</span></div><div class="counter"><button type="button" data-act="minus">−</button><div class="value ${cnt === 0 ? 'zero' : ''}">${cnt}</div><button type="button" data-act="plus">+</button></div>`;
        const val = row.querySelector('.value');
        row.querySelectorAll('button[data-act]').forEach(b => b.addEventListener('click', e => {
          e.preventDefault();
          const cur = getCount1(item.id);
          try { vibro(15); } catch (er) {}
          setCount1(item.id, b.dataset.act === 'plus' ? cur + 1 : cur - 1);   // как в «Сегодня»: сохраняет, пересчитывает итоги
          const v = getCount1(item.id);
          val.textContent = v; val.classList.toggle('zero', v === 0);
          updBadge();
        }));
        sbody.appendChild(row);
      });
      title.addEventListener('click', () => {
        const open = sbody.style.display === 'none';
        sbody.style.display = open ? 'block' : 'none';
        arrow.style.transform = open ? 'rotate(180deg)' : 'rotate(0deg)';
        try { vibro(8); } catch (er) {}
      });
      sec.appendChild(title); sec.appendChild(sbody);
      body.appendChild(sec);
    });
  }
  let built = false;
  function setOpen(open) {
    if (open && !built) { build(); built = true; }
    body.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    const ic = btn.querySelector('.ptb-icon'); if (ic) ic.style.transform = open ? 'rotate(180deg)' : '';
    if (asSheet) window.__mvsProdOpenSheet = open;   // после перерисовки панели аккордеон остаётся раскрытым
  }
  btn.addEventListener('click', () => { setOpen(!body.classList.contains('open')); try { vibro(10); } catch (er) {} });
  if (asSheet && window.__mvsProdOpenSheet) setOpen(true);
  return wrap;
}
