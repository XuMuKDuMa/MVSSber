function getSalesForMonth(year, month) {
  const h = loadHistory1();
  const acc = {};
  Object.keys(h).forEach(dateStr => {
    const parts = dateStr.split('.');
    if (parts.length !== 3) return;
    const m = parseInt(parts[1]) - 1, y = parseInt(parts[2]);
    if (m !== month || y !== year) return;
    const sales = h[dateStr].sales;
    if (!sales) return;
    Object.keys(sales).forEach(k => {
      const item = sales[k];
      if (!item || typeof item !== 'object') return;
      const count = item.count || 0;
      if (count <= 0) return;
      const accKey = item.name && item.name.trim() ? item.name.trim() : k;
      if (!acc[accKey]) acc[accKey] = { name: item.name || k, icon: item.icon || '📦', color: item.color || '#95a5a6', count: 0 };
      acc[accKey].count += count;
    });
  });
  const entries = Object.keys(acc).map(k => acc[k]).sort((a, b) => b.count - a.count);
  const totalSum = entries.reduce((s, e) => s + e.count, 0);
  return { entries, totalSum };
}
