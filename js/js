// Уведомления в стиле iOS: плавающая «стеклянная» карточка сверху
// ═══════════════════════════════════════════════
function iosBanner(o) {
  o = o || {};
  const title = String(o.title || '').trim();
  if (!title) return;
  let wrap = document.getElementById('iosBannerWrap');
  if (!wrap) {
    wrap = document.createElement('div');
    wrap.id = 'iosBannerWrap';
    document.body.appendChild(wrap);
  }
  // тот же текст подряд — не дублируем
  if (wrap._lastTitle === title && Date.now() - (wrap._lastAt || 0) < 1200) return;
  wrap._lastTitle = title; wrap._lastAt = Date.now();

  const el = document.createElement('div');
  const hasActions = !!(o.actions && o.actions.length);
  el.className = 'ios-banner' + (o.kind ? ' k-' + o.kind : '') + (hasActions ? ' has-actions' : '');
  el.innerHTML = '<div class="ib-icon"></div><div class="ib-body"><div class="ib-title"></div><div class="ib-sub"></div></div><div class="ib-time">сейчас</div>';
  el.querySelector('.ib-icon').textContent = o.icon || '🔔';
  el.querySelector('.ib-title').textContent = title;
  const subEl = el.querySelector('.ib-sub');
  if (o.sub) subEl.textContent = o.sub; else subEl.remove();
  if (hasActions) {
    const row = document.createElement('div');
    row.className = 'ib-actions';
    o.actions.forEach(a => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'ib-btn' + (a.primary ? ' primary' : '');
      b.textContent = a.label;
      b.addEventListener('click', (e) => { e.stopPropagation(); dismiss(); try { a.fn && a.fn(); } catch (err) { console.warn(err); } });
      b.addEventListener('touchstart', (e) => e.stopPropagation(), { passive: true });
      row.appendChild(b);
    });
    el.querySelector('.ib-body').appendChild(row);
  }
  el._sticky = !!o.sticky;
  wrap.insertBefore(el, wrap.firstChild);                    // новое — сверху, как в iOS
  // не больше 3 баннеров; «липкие» напоминания не выкидываем
  let extra = wrap.children.length - 3;
  for (let i = wrap.children.length - 1; i >= 0 && extra > 0; i--) {
    const c = wrap.children[i];
    if (!c._sticky) { c.remove(); extra--; }
  }
  requestAnimationFrame(() => requestAnimationFrame(() => el.classList.add('in')));

  let timer = o.sticky ? null : setTimeout(dismiss, o.duration || 3200);
  function dismiss() {
    if (el._gone) return;
    el._gone = true; clearTimeout(timer);
    el.classList.remove('in'); el.classList.add('out');
    setTimeout(() => el.remove(), 400);
  }
  // свайп вверх — убрать, тап — убрать
  let y0 = null, dy = 0;
  el.addEventListener('touchstart', e => { y0 = e.touches[0].clientY; dy = 0; clearTimeout(timer); el.style.transition = 'none'; }, { passive: true });
  el.addEventListener('touchmove', e => { if (y0 == null) return; dy = Math.min(0, e.touches[0].clientY - y0); el.style.transform = 'translateY(' + dy + 'px)'; }, { passive: true });
  el.addEventListener('touchend', () => {
    el.style.transition = ''; el.style.transform = '';
    if (dy < -24) dismiss(); else if (!o.sticky) timer = setTimeout(dismiss, 1800);
    y0 = null;
  });
  if (!o.sticky) el.addEventListener('click', dismiss);
  return { el, dismiss };
}

// Обычные сообщения: эмодзи в начале текста становится иконкой баннера
function showToast(text) {
  let t = String(text || '').trim();
  let icon = '🔔', kind = '';
  const m = t.match(/^(?:\p{Extended_Pictographic}\uFE0F?|[✓✔✗✘✕])\s*/u);
  if (m) {
    icon = m[0].trim();
    t = t.slice(m[0].length).trim();
    const g = icon.replace(/\uFE0F/g, '');
    if (g === '⚠') kind = 'warn';
    else if (['❌', '✗', '✘', '✕', '⛔'].includes(g)) kind = 'error';
    else if (['✓', '✔', '✅'].includes(g)) kind = 'ok';
    else if (g === 'ℹ') kind = 'info';
    if (kind === 'ok') icon = '✓';
    if (kind === 'error') icon = '✕';
    if (kind === 'warn') icon = '!';
    if (kind === 'info') icon = 'i';
  }
  iosBanner({ title: t || String(text), icon, kind });
}
