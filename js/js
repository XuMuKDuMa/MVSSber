// ─── Открыть карту на конкретном адресе ───
window.openMapForAddress = async function(addr) {
  const cleanAddr = String(addr || '').trim();
  if (!cleanAddr) { showToast('⚠️ Адрес пустой'); return; }
  vibro(15);
  goToTab(5);

  // Дождаться инициализации карты после переключения вкладки.
  let attempts = 0;
  while (!map && attempts++ < 40) await new Promise(resolve => setTimeout(resolve, 200));
  if (!map) { showToast('⚠️ Карта не загрузилась'); return; }

  // Leaflet часто инициализируется в скрытой вкладке — пересчитать размеры после показа.
  setTimeout(() => { try { map && map.invalidateSize(true); } catch (_) {} }, 120);

  // Найти координаты именно выбранного адреса; геокодировать, если кэш пуст.
  let coords = null;
  const target = cleanAddr.toLowerCase().replace(/\s+/g, ' ').trim();
  for (const key of Object.keys(mapGeocache || {})) {
    const normalized = key.toLowerCase().replace(/\s+/g, ' ').trim();
    if (normalized === target || normalized.includes(target) || target.includes(normalized)) {
      if (mapGeocache[key]) { coords = mapGeocache[key]; break; }
    }
  }
  if (!coords) {
    try { coords = await geocodeAddress(cleanAddr); } catch (_) { coords = null; }
  }
  if (!coords || !map) { showToast('⚠️ Не удалось найти координаты адреса'); return; }

  map.setView(coords, 18, { animate: true, duration: 0.7 });
  // Перерисовать маркеры, затем открыть попап нужной встречи по адресу.
  try { await renderMapMarkers(); } catch (_) {}
  setTimeout(() => {
    if (!map) return;
    let closest = null, bestDistance = Infinity;
    (mapMarkers || []).forEach(marker => {
      const markerAddr = String(marker._mvsAddress || '').replace(/\s+/g, ' ').trim();
      const ll = marker.getLatLng();
      const dist = Math.abs(ll.lat - coords[0]) + Math.abs(ll.lng - coords[1]);
      const addressMatch = markerAddr === target || markerAddr.includes(target) || target.includes(markerAddr);
      if (addressMatch && dist < bestDistance) { closest = marker; bestDistance = dist; }
    });
    if (!closest) {
      (mapMarkers || []).forEach(marker => {
        const ll = marker.getLatLng();
        const dist = Math.abs(ll.lat - coords[0]) + Math.abs(ll.lng - coords[1]);
        if (dist < bestDistance) { closest = marker; bestDistance = dist; }
      });
    }
    if (closest) {
      map.setView(closest.getLatLng(), 18, { animate: true, duration: 0.5 });
      closest.openPopup();
    }
  }, 650);
  showToast('📍 ' + cleanAddr);
};
window.openNavigator = function(addrEncoded) {
  vibro(15);
  const addr = decodeURIComponent(addrEncoded || '').trim();
  if (!addr) {
    showToast('⚠️ Нет адреса');
    return;
  }
