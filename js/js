  function inCity(p, cityN) {
    if (!cityN) return true;
    const fields = [p.city, p.town, p.village, p.locality, p.district, p.county, p.state_district].filter(Boolean);
    if (!fields.length) return true;                       // нет данных о городе — не считаем чужим
