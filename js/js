  const norm = v => String(v || '').toLowerCase().replace(/ё/g, 'е').replace(/[acepoxkmtbh]/g, ch => LAT2CYR[ch]).replace(/[.,]/g, ' ').replace(/\s+/g, ' ').trim();
  // убираем «улица / ул. / проспект …», чтобы сравнивать только название
