  document.getElementById('fuelCons').value = f.cons ? String(f.cons).replace('.', ',') : '';
  document.getElementById('fuelPrice').value = f.price ? String(f.price).replace('.', ',') : '';
  document.getElementById('fuelModal').classList.add('show');
}
