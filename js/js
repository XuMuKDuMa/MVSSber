document.getElementById('btnImportData').addEventListener('click', () => {
  document.getElementById('menu3')?.classList.remove('show');

  const inp = document.createElement('input');
  inp.type = 'file';
  inp.accept = '.json,application/json';
  inp.style.display = 'none';
  document.body.appendChild(inp);

  inp.addEventListener('change', (e) => {
    const file = e.target.files && e.target.files[0];
    if (!file) { document.body.removeChild(inp); return; }

    const reader = new FileReader();
    reader.onload = (ev) => {
      try {
        const dump = JSON.parse(ev.target.result);
        if (!dump || !dump.data || typeof dump.data !== 'object') {
          showToast('❌ Неверный формат файла');
          return;
        }
        const exported = dump._exportedAt
          ? new Date(dump._exportedAt).toLocaleString('ru-RU')
          : 'неизвестно';
        const keysCount = Object.keys(dump.data).length;

        if (!confirm(
          `Загрузить данные?\n\n` +
          `📅 Файл от: ${exported}\n` +
          `📦 Записей: ${keysCount}\n\n` +
          `⚠️ ТЕКУЩИЕ ДАННЫЕ БУДУТ ЗАМЕНЕНЫ!`
        )) return;

        let restored = 0;
        BACKUP_KEYS.forEach(key => {
          if (dump.data[key] !== undefined) {
            localStorage.setItem(key, dump.data[key]);
            restored++;
          }
        });

        vibro([50, 50, 100]);
        showToast(`✅ Загружено ${restored} записей. Перезагрузка...`);
        setTimeout(() => location.reload(), 1000);
      } catch (err) {
        console.error('Import error:', err);
        showToast('❌ Ошибка: ' + err.message);
      } finally {
        document.body.removeChild(inp);
      }
    };
    reader.onerror = () => {
      showToast('❌ Не удалось прочитать файл');
      document.body.removeChild(inp);
    };
    reader.readAsText(file);
  });

  inp.click();
});
