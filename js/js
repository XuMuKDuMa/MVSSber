  let slotW;      // ширина слота (один день)
  let barW;       // ширина одного столбика
  let minW;       // минимальная общая ширина svg

    if (n <= 5) {
    slotW = 56;
    barW = 20;
    minW = 340;
  } else if (n <= 10) {
    slotW = 46;
    barW = 16;
    minW = 340;
  } else if (n <= 15) {
    slotW = 44;   // ← было 42 — чуть шире
    barW = 14;
    minW = 44 * n + 50;   // ← ВСЕГДА считаем реальную ширину
  } else {
    slotW = 42;   // ← было 38 — заметно шире
    barW = 13;
    minW = 42 * n + 50;   // ← для 22 дней = 974px
  }
  const innerH = H - PAD_T - PAD_B;

  // Вычисляем ширину svg
  const calcW = PAD_L + PAD_R + slotW * n;
  const W = Math.max(calcW, minW);

  // Если W больше контейнера — скролл; если меньше — центрируем
  const slotPadding = n <= 10 ? (W - PAD_L - PAD_R - slotW * n) / 2 : 0;
  const startX = PAD_L + slotPadding;

  // Значения и норматив
  const valuesUP = sorted.map(d => d.up);
  const valuesFD = sorted.map(d => d.upFD || 0);
  const wdStats = getWorkingDaysStats();
  const normUP = planUP > 0 && wdStats.total > 0 ? planUP / wdStats.total : 0;
  const maxVal = Math.max(...valuesUP, ...valuesFD, normUP, 1) * 1.1;

  const toY = (v) => PAD_T + innerH - (v / maxVal) * innerH;
  const toX = (i) => startX + slotW * i + slotW / 2;

  // ─── Столбики ───
  let bars = '';
  sorted.forEach((d, i) => {
    const cx = toX(i);
    const gap = 2;

    // УП общий — левый
    const upH = (d.up / maxVal) * innerH;
    const upX = cx - barW - gap / 2;
    const upY = PAD_T + innerH - upH;
    if (upH > 0) {
      bars += `<rect x="${upX}" y="${upY}" width="${barW}" height="${upH}" rx="2" fill="#27ae60"/>`;
      // Значение над столбиком (только если столбиков ≤ 10)
      if (n <= 10) {
        bars += `<text x="${upX + barW/2}" y="${upY - 3}" text-anchor="middle" font-size="9" font-weight="700" fill="#27ae60">${d.up.toFixed(2)}</text>`;
      }
    }

    // УП на ФД — правый
    const fdH = ((d.upFD || 0) / maxVal) * innerH;
    const fdX = cx + gap / 2;
    const fdY = PAD_T + innerH - fdH;
    if (fdH > 0) {
      bars += `<rect x="${fdX}" y="${fdY}" width="${barW}" height="${fdH}" rx="2" fill="#f39c12"/>`;
      if (n <= 10) {
        bars += `<text x="${fdX + barW/2}" y="${fdY - 3}" text-anchor="middle" font-size="9" font-weight="700" fill="#f39c12">${(d.upFD || 0).toFixed(2)}</text>`;
      }
    }
  });

  // ─── Линия норматива ───
  let normLine = '';
  if (normUP > 0) {
    const yNorm = toY(normUP);
    normLine = `
      <line x1="${PAD_L}" y1="${yNorm}" x2="${W - PAD_R}" y2="${yNorm}"
        stroke="#3498db" stroke-width="1.5" stroke-dasharray="4 3" opacity="0.75"/>
      <text x="${W - PAD_R}" y="${yNorm - 4}" text-anchor="end" font-size="9" font-weight="700" fill="#3498db">
        ${normUP.toFixed(2)}
      </text>
    `;
  }

  // ─── Подписи по Y ───
  const yLabels = `
    <text x="${PAD_L - 5}" y="${PAD_T + 4}" text-anchor="end" font-size="9" fill="#888">${maxVal.toFixed(1)}</text>
    <text x="${PAD_L - 5}" y="${PAD_T + innerH + 3}" text-anchor="end" font-size="9" fill="#888">0</text>
  `;

  // ─── Подписи по X (дни) ───
  let xLabels = '';
  sorted.forEach((d, i) => {
    const cx = toX(i);
    const dayNum = d.date.split('.')[0];
    xLabels += `<text x="${cx}" y="${PAD_T + innerH + 15}" text-anchor="middle" font-size="10" font-weight="600" fill="#666">${dayNum}</text>`;
  });

  // ─── Статистика ───
  const sumUP = valuesUP.reduce((s, v) => s + v, 0);
  const sumFD = valuesFD.reduce((s, v) => s + v, 0);
  const avgUP = sumUP / valuesUP.length;
  const maxDay = sorted.reduce((a, b) => (a.up > b.up ? a : b));
  const minDay = sorted.reduce((a, b) => (a.up < b.up ? a : b));

  // ─── Индикатор, нужен ли скролл ───
  const needScroll = W > 360;
  const scrollHint = needScroll
    ? `<div class="up-chart-scroll-hint">← прокрути →</div>`
    : '';

  return `
    <div class="up-chart-wrap">
      <svg viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" class="up-chart-svg" preserveAspectRatio="xMinYMid meet">
        <line x1="${PAD_L}" y1="${PAD_T}" x2="${PAD_L}" y2="${PAD_T + innerH}" stroke="#e0e4e8" stroke-width="1"/>
        <line x1="${PAD_L}" y1="${PAD_T + innerH}" x2="${W - PAD_R}" y2="${PAD_T + innerH}" stroke="#e0e4e8" stroke-width="1"/>
        ${normLine}
        ${bars}
        ${yLabels}
        ${xLabels}
      </svg>
    </div>
    ${scrollHint}

    <div class="up-chart-legend">
      <div class="ucl-item">
        <span class="ucl-square" style="background:#27ae60;"></span>
        <span>УП общий</span>
      </div>
      <div class="ucl-item">
        <span class="ucl-square" style="background:#f39c12;"></span>
        <span>УП на ФД (KPI)</span>
      </div>
      ${normUP > 0 ? `
      <div class="ucl-item">
        <span class="ucl-line" style="background:#3498db;"></span>
        <span>Норматив</span>
      </div>` : ''}
    </div>

    <div class="up-chart-stats">
      <div class="ucs-item"><span class="ucs-label">Среднее</span><span class="ucs-val">${avgUP.toFixed(2)}</span></div>
      <div class="ucs-item"><span class="ucs-label">Макс</span><span class="ucs-val green">${maxDay.up.toFixed(2)}</span></div>
      <div class="ucs-item"><span class="ucs-label">Мин</span><span class="ucs-val red">${minDay.up.toFixed(2)}</span></div>
      <div class="ucs-item"><span class="ucs-label">Дней</span><span class="ucs-val">${sorted.length}</span></div>
    </div>

    <div class="up-chart-kpi">
      <div class="uck-item">
        <span class="uck-label">УП общий</span>
        <span class="uck-val">${sumUP.toFixed(2)}</span>
      </div>
      <div class="uck-item">
        <span class="uck-label">УП на ФД</span>
        <span class="uck-val orange">${sumFD.toFixed(2)}</span>
      </div>
      <div class="uck-item">
        <span class="uck-label">Доля ФД</span>
        <span class="uck-val ${sumUP > 0 && (sumFD/sumUP) >= 0.6 ? 'green' : (sumUP > 0 && (sumFD/sumUP) >= 0.4 ? 'orange' : 'red')}">
          ${sumUP > 0 ? Math.round((sumFD / sumUP) * 100) + '%' : '—'}
        </span>
      </div>
    </div>
  `;
}

function buildCalendarHtml(wdStats) {
  const now = new Date();
  const year = now.getFullYear();
  const month = now.getMonth();
  const monthTitle = now.toLocaleDateString('ru-RU', { month: 'long', year: 'numeric' });
  function mondayIdx(d) { return (d.getDay() + 6) % 7; }
  const firstDay = new Date(year, month, 1);
  const lastDay = new Date(year, month + 1, 0).getDate();
  const leadingEmpty = mondayIdx(firstDay);
  const headHtml = ['Пн','Вт','Ср','Чт','Пт','Сб','Вс']
    .map((d, i) => `<div class="cal-head${i >= 5 ? ' weekend' : ''}">${d}</div>`).join('');
  let cellsHtml = '';
  for (let i = 0; i < leadingEmpty; i++) cellsHtml += `<div class="cal-cell empty"></div>`;
  const todayDate = now.getDate();
  for (let day = 1; day <= lastDay; day++) {
    const dateObj = new Date(year, month, day);
    const holiday = isHoliday(dateObj);
    const weekend = isWeekend(dateObj);
    const isToday = day === todayDate;
    const absence = (loadCalendarAbsences()[calendarDateKey(dateObj)] || '');
    let cls = 'cal-cell';
    if (holiday) cls += ' holiday';
    else if (weekend) cls += ' weekend';
    if (absence === 'vacation') cls += ' cal-vacation';
    if (absence === 'sick') cls += ' cal-sick';
    if (isToday) cls += ' today';
    const marker = absence === 'vacation' ? '🏖️' : (absence === 'sick' ? '🤒' : '');
    cellsHtml += `<div class="${cls}" data-calendar-day="${day}" title="Нажми, чтобы отметить отпуск или больничный">${day}${marker ? `<span style="position:absolute;bottom:1px;right:2px;font-size:10px;">${marker}</span>` : ''}</div>`;
  }
  const totalCells = leadingEmpty + lastDay;
  const trailingEmpty = (7 - (totalCells % 7)) % 7;
  for (let i = 0; i < trailingEmpty; i++) cellsHtml += `<div class="cal-cell empty"></div>`;
  const legendHtml = `<div class="cal-legend"><span><span class="dot red"></span>выходной / праздник (*)</span><span>🏖️ отпуск</span><span>🤒 больничный</span><span><span class="dot green"></span>сегодня</span></div><div style="font-size:11px;text-align:center;color:#7f8c8d;margin-top:6px;">Нажми на дату: обычный день → отпуск → больничный → обычный день. Отпуск и больничный исключаются из рабочих дней.</div>`;
  return `<div class="cal-wrap" id="daysList"><div class="cal-title">${monthTitle}</div><div class="cal-grid">${headHtml}${cellsHtml}</div>${legendHtml}</div>`;
}

