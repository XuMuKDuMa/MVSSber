function calcTotals1() {
  let up = 0, od = 0, upFD = 0, meetings = 0, bizMeetings = 0;
  SECTIONS1.forEach(s => s.items.forEach(i => {
    const c = getCount1(i.id);
    up += c * i.up; od += c * i.od;
    if (i.type === 'meeting') meetings += c;
    else if (i.type === 'biz') bizMeetings += c;
    else upFD += c * i.up;
  }));
  const zkCount = num(getZK1());
  up += zkCount * ZK_COEF;
  (state1.extra || []).forEach(x => { upFD += num(x.up); od += num(x.od); });

// ─── B2C и B2B: адреса + счётчики встреч + ручной override ───

// 1. Считаем адреса из активностей по категориям
let b2cFromActivities = 0;
let b2bFromActivities = 0;
let b2cDone = 0;
let b2bDone = 0;

ROUTE_TIMES.forEach(t => {
  (routeState.lists[t.id] || []).forEach(item => {
    if (!item) return;
    if (!item.addr || !item.addr.trim()) return;
    
    const cat = item.category || 'b2c';   // по умолчанию B2C
    
    if (cat === 'b2b') {
      b2bFromActivities++;
      if (item.status === 'done') b2bDone++;
    } else {
      b2cFromActivities++;
      if (item.status === 'done') b2cDone++;
    }
  });
});
// 2. B2C — ТОЛЬКО из активностей (карточки встреч)
// ⚠️ Плюсики «Встреча ФД» больше НЕ считаем в B2C — они идут только в УП!
let b2cFromMeetings = 0;
SECTIONS1.forEach(s => s.items.forEach(i => {
  if (i.type === 'meeting') b2cFromMeetings += getCount1(i.id);
  // B2B (type: 'biz') — НЕ считаем, он в слайдере
}));

// 3. Ручной override для B2C
const b2cManualRaw = String(getManual1('b2c_total') || '').trim();
const b2cManual = (b2cManualRaw !== '' && b2cManualRaw !== '0')
  ? (Number(b2cManualRaw) || 0)
  : null;

const b2cAuto = b2cFromActivities;
const b2cTotal = b2cManual !== null ? b2cManual : b2cAuto;

// 4. Ручной override для B2B
const b2bManualRaw = String(getManual1('b2b_total') || '').trim();
const b2bManual = (b2bManualRaw !== '' && b2bManualRaw !== '0')
  ? (Number(b2bManualRaw) || 0)
  : null;

// ⚠️ B2B — только из активностей (не из секций)
const b2bAuto = b2bFromActivities;
const b2bTotal = b2bManual !== null ? b2bManual : b2bAuto;

return { up, od, upFD, meetings, bizMeetings,
         b2cTotal, b2cAuto, b2cDone,
         b2bTotal, b2bAuto, b2bDone,
         zkCount };
}
