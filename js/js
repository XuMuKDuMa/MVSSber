    if (o.chips && window.mvsRenderReasonChips) { window.mvsRenderReasonChips(chipsBox, ta); chipsBox.style.display = ''; }
    else { chipsBox.innerHTML = ''; chipsBox.style.display = 'none'; }
    bd.classList.add('show');
    try { ta.setSelectionRange(ta.value.length, ta.value.length); } catch (e) {}   // курсор в конец ДО фокуса: клавиатуре не нужно перестраиваться
    try { vibro(10); } catch (e) {}
    // Фокус СРАЗУ, пока длится жест пользователя (иначе Android WebView иногда не даёт ввод),
