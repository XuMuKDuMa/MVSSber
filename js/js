          const mentionsOther = fields.some(v => v && !(
            v === wanted || v === 'г ' + wanted || v === 'город ' + wanted || v === 'г. ' + wanted ||
            v.startsWith(wanted + ',') || v.startsWith('г ' + wanted + ',') || v.startsWith('город ' + wanted + ',')
          ));
