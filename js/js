      const blocked = new Set(results.filter(r => !r.ok && r.err !== 'timeout' && !okHosts.has(r.host)).map(r => r.host));
      if (blocked.size >= 4) {
        vpn = true;
        reason = 'сервисы определения IP недоступны (' + blocked.size + ' из ' + new Set(results.map(r => r.host)).size + ') — так бывает при VPN';
