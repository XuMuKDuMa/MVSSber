function avgUpFdPerMeeting() {
  // средний УП от продаж (УП ФД) на одну ФД-встречу по прошлым дням
  try {
    const h = loadHistory1();
    const todayStr = new Date().toLocaleDateString('ru-RU');
    let up = 0, m = 0, days = 0;
    Object.keys(h).forEach(k => {
      if (k === todayStr) return;
      const e = h[k];
      if (e && e.meetings > 0) { up += Number(e.upFD) || 0; m += e.meetings; days++; }
    });
    return m > 0 ? { avg: up / m, days, meetings: m } : null;
  } catch (e) { return null; }
}
function avgDayUpFromHistory() {
  try {
    const h = loadHistory1();
    const todayStr = new Date().toLocaleDateString('ru-RU');
    const now = new Date();
    let sum = 0, n = 0;
    Object.keys(h).forEach(k => {
      if (k === todayStr) return;
      const p = k.split('.');
      if (p.length !== 3) return;
      if (parseInt(p[1], 10) - 1 !== now.getMonth() || parseInt(p[2], 10) !== now.getFullYear()) return;
      const e = h[k];
      if (e && e.up > 0) { sum += e.up; n++; }
    });
    return n > 0 ? { avg: sum / n, days: n } : null;
  } catch (e) { return null; }
}
