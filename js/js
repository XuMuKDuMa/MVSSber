  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return HOLIDAYS[y + '-' + m + '-' + d] || null;
}
function isWeekend(date) { const day = date.getDay(); return day === 0 || day === 6; }
function isWorkingDay(date) { if (isWeekend(date)) return false; if (isHoliday(date)) return false; return true; }
const ABSENCE_CAL_KEY = 'mvs_totals_absences_v1';
function loadCalendarAbsences() {
  try { return JSON.parse(localStorage.getItem(ABSENCE_CAL_KEY) || '{}') || {}; }
  catch (e) { return {}; }
}
function saveCalendarAbsences(data) { localStorage.setItem(ABSENCE_CAL_KEY, JSON.stringify(data)); }
function calendarDateKey(date) {
  return date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0');
}
function getWorkingDaysStats(refDate = new Date()) {
  const absences = loadCalendarAbsences();
  const year = refDate.getFullYear();
  const month = refDate.getMonth();
  const today = new Date(year, month, refDate.getDate());
  const lastDay = new Date(year, month + 1, 0).getDate();
  let total = 0, past = 0, remaining = 0;
  const days = [];
  for (let d = 1; d <= lastDay; d++) {
    const date = new Date(year, month, d);
    const absence = absences[calendarDateKey(date)] || '';
    const working = isWorkingDay(date) && !absence;
    const holiday = isHoliday(date);
    const weekend = isWeekend(date);
    const isToday = d === today.getDate();
    days.push({ date: d, dateObj: date, working, holiday, weekend, isToday, absence });
    if (working) { total++; if (d < today.getDate()) past++; else remaining++; }
  }
  return { total, past, remaining, days };
}

