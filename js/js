document.getElementById('btnTestNotif')?.addEventListener('click', async () => {
  document.getElementById('menu3')?.classList.remove('show');
  vibro(10);
  const out = [];
  const hasApi = ('Notification' in window);
  out.push('Notification API: ' + (hasApi ? 'есть' : 'НЕТ'));
  out.push('Service Worker: ' + (('serviceWorker' in navigator) ? 'есть' : 'НЕТ'));
  if (!hasApi) {
    out.push('', 'Итог: в этой оболочке системные уведомления недоступны.');
    vpnShowReport(out, '🔔 Проверка уведомлений');
    return;
  }
  out.push('Разрешение до запроса: ' + Notification.permission);
  let perm = Notification.permission;
  if (perm === 'default') {
    try { perm = await Notification.requestPermission(); } catch (e) { out.push('Запрос разрешения: ошибка ' + (e && e.name)); }
  }
  out.push('Разрешение сейчас: ' + perm);
  if (perm !== 'granted') {
    out.push('', 'Итог: разрешения нет. Проверь настройки уведомлений приложения в Android.');
    vpnShowReport(out, '🔔 Проверка уведомлений');
    return;
  }
  const opts = { body: 'Если ты видишь это в шторке — уведомления работают', tag: 'mvs-test', requireInteraction: true };
  let shown = false;
  // способ 1: напрямую — сборщик превращает new Notification() в системное уведомление
  try { new Notification('МВС отчёты', opts); out.push('Напрямую (new Notification): отправлено ✓'); shown = true; }
  catch (e) { out.push('Напрямую: ошибка — ' + (e && e.message || e)); }
  // способ 2: через Service Worker (запасной)
  if (!shown) {
    try {
      if ('serviceWorker' in navigator) {
        const reg = await Promise.race([
          navigator.serviceWorker.ready,
          new Promise((_, rej) => setTimeout(() => rej(new Error('SW не готов')), 3000))
        ]);
        await reg.showNotification('МВС отчёты', opts);
        out.push('Через Service Worker: отправлено ✓');
        shown = true;
      }
    } catch (e) { out.push('Через Service Worker: ошибка — ' + (e && e.message || e)); }
  }
  out.push('', shown
    ? 'Итог: команда отправлена. Посмотри шторку: если уведомление появилось — работает, и можно делать «встреча в работе» в шторке. Если шторка пустая — оболочка уведомления не пропускает.'
    : 'Итог: показать уведомление не удалось.');
  vpnShowReport(out, '🔔 Проверка уведомлений');
});


/* ═══════════════════════════════════════════════
   Уведомление в шторке: «Встреча в работе» (пока нажато «Начать» и не «Завершить»)
   ═══════════════════════════════════════════════ */
let _liveKey = null;
function liveNotifOk() {
  return ('Notification' in window) && Notification.permission === 'granted';
}
async function liveNotifHide() {
  try { if (window._liveN && window._liveN.close) window._liveN.close(); } catch (e) {}
  window._liveN = null;
  try {
    if ('serviceWorker' in navigator) {
      const reg = await navigator.serviceWorker.getRegistration();
      if (reg && reg.getNotifications) {
        (await reg.getNotifications({ tag: 'mvs-live' })).forEach(n => n.close());
      }
    }
  } catch (e) {}
}
async function liveNotifShow(item) {
  if (!liveNotifOk()) return;
  const t = new Date(item.startedAt);
  const hh = String(t.getHours()).padStart(2, '0') + ':' + String(t.getMinutes()).padStart(2, '0');
  const opts = {
    body: (item.addr && item.addr.trim() ? item.addr.trim() : 'Адрес не указан') + '\nс ' + hh + ' · тап — вернуться в приложение',
    tag: 'mvs-live',
    requireInteraction: true,
    silent: true
  };
  try { window._liveN = new Notification('Встреча в работе', opts); return; } catch (e) {}
  try {
    if ('serviceWorker' in navigator) {
      const reg = await navigator.serviceWorker.ready;
      await reg.showNotification('Встреча в работе', opts);
    }
  } catch (e) { console.warn('liveNotif', e); }
}
// Сверяем уведомление с состоянием маршрута (вызывается после каждой перерисовки)
function liveNotifSync() {
  try {
    let live = null;
    ROUTE_TIMES.forEach(t => (routeState.lists[t.id] || []).forEach(it => {
      if (it && it.startedAt && (!live || it.startedAt < live.startedAt)) live = it;
    }));
    const key = live ? live.startedAt + '|' + (live.addr || '') : null;
    if (key === _liveKey) return;
    _liveKey = key;
    if (live) liveNotifShow(live); else liveNotifHide();
  } catch (e) { console.warn('liveNotifSync', e); }
}

