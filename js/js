// Единая подгонка высоты полей адреса / заметки / причины.
// Раньше работало 5 скриптов: на каждое нажатие они сбрасывали высоту поля в 0/auto и ставили её
// заново по 3–4 раза — прямо посреди набора. Экранная клавиатура Android (особенно русская, со словарём)
// из-за этого теряла композицию и не печатала. Теперь:
//  • во время набора поле только РАСТЁТ (без сброса высоты);
//  • полный пересчёт (в том числе уменьшение) — только после композиции, при blur и change;
//  • пока идёт композиция слова — поле вообще не трогаем.
(function () {
  'use strict';
  var SEL = 'textarea.route-addr-input, textarea.route-note-input, textarea.route-nondelivery-input';
  function isField(el) { return !!(el && el.matches && el.matches(SEL)); }
  function usable(el) {
    return el.isConnected && el.clientWidth > 0 && !(el.closest && el.closest('.route-card.collapsed'));
  }
  function setH(el, h) {
    el.style.setProperty('height', h + 'px', 'important');
    el.style.setProperty('max-height', 'none', 'important');
    el.style.setProperty('overflow', 'hidden', 'important');
  }
  function borders(el) {
    var cs = getComputedStyle(el);
    return cs.boxSizing === 'border-box' ? (parseFloat(cs.borderTopWidth) || 0) + (parseFloat(cs.borderBottomWidth) || 0) : 0;
  }
  function grow(el, full) {
    if (!isField(el) || !usable(el) || el.__mvsComposing) return;
    var b = borders(el);
    var need = Math.max(44, Math.ceil(el.scrollHeight + b));
    if (need > el.offsetHeight) { setH(el, need); return; }          // рост — без сброса высоты
    if (full && need < el.offsetHeight - 1) {                          // уменьшение — только в «тихий» момент
      el.style.setProperty('height', '0px', 'important');
      setH(el, Math.max(44, Math.ceil(el.scrollHeight + b)));
    }
  }
  window.mvsGrowField = function (el) { grow(el, document.activeElement !== el); };

  function later(el, full) {
    requestAnimationFrame(function () { grow(el, full); });
  }
  document.addEventListener('compositionstart', function (e) { if (isField(e.target)) e.target.__mvsComposing = true; }, true);
  document.addEventListener('compositionend', function (e) {
    if (!isField(e.target)) return;
    e.target.__mvsComposing = false;
    later(e.target, true);
  }, true);
  document.addEventListener('input', function (e) { if (isField(e.target)) grow(e.target, false); }, true);
  ['change', 'blur'].forEach(function (t) {
    document.addEventListener(t, function (e) { if (isField(e.target)) later(e.target, true); }, true);
  });
  ['paste', 'cut'].forEach(function (t) {
    document.addEventListener(t, function (e) { if (isField(e.target)) setTimeout(function () { grow(e.target, false); }, 0); }, true);
  });

  function scan(root, full) {
    (root || document).querySelectorAll(SEL).forEach(function (el) {
      if (el === document.activeElement) return;      // поле, в которое сейчас печатают, не трогаем
      grow(el, full !== false);
    });
  }
  function scanSoon(root) {
    requestAnimationFrame(function () { scan(root); });
    setTimeout(function () { scan(root); }, 150);
  }

  // Если поле, в которое печатали, скрыли (карточку свернули, слот закрыли), снимаем с него фокус:
  // иначе при возврате оно остаётся «активным» без живой связи с клавиатурой и русский текст не вводится.
  function dropStaleFocus() {
    var a = document.activeElement;
    if (!a || a === document.body || !/^(TEXTAREA|INPUT)$/.test(a.tagName)) return;
    if (a.getClientRects().length === 0 || (a.closest && a.closest('.route-card.collapsed'))) { try { a.blur(); } catch (e) {} }
  }

  function start() {
    scanSoon(document);
    if (!window.MutationObserver) return;
    new MutationObserver(function (list) {
      list.forEach(function (m) {
        if (m.type === 'childList') {
          m.addedNodes.forEach(function (n) {
            if (n.nodeType !== 1) return;
            if (isField(n)) scanSoon(n.parentNode);
            else if (n.querySelector && n.querySelector(SEL)) scanSoon(n);
          });
        } else if (m.type === 'attributes') {
          dropStaleFocus();
          var c = m.target;     // карточка раскрылась (снят .collapsed) — поля были скрыты и имели высоту 0
          if (c.classList && c.classList.contains('route-card') && !c.classList.contains('collapsed')) scanSoon(c);
        }
      });
    }).observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start, { once: true });
  else start();
  window.addEventListener('orientationchange', function () { setTimeout(function () { scan(document); }, 250); });
  window.addEventListener('resize', function () {      // resize приходит и при открытии клавиатуры — активное поле не трогаем
    clearTimeout(window.__mvsGrowRs);
    window.__mvsGrowRs = setTimeout(function () { scan(document); }, 200);
  });
})();

// Фоновый контроль VPN. Раньше проверка запускалась только при открытии вкладки «Карта» и нажатии «Маршрут»,
// поэтому на других экранах и при включении VPN уже во время работы предупреждение не приходило.
(function () {
  'use strict';
  var last = 0, MIN_GAP = 60000, EVERY = 10 * 60 * 1000;   // раньше: не чаще раза в 15 с и по таймеру каждые 3 минуты
  function run(reason) {
    try {
      if (typeof checkVpnAndWarn !== 'function' || document.hidden) return;
      if (navigator.onLine === false) return;
      var now = Date.now();
      if (now - last < MIN_GAP) return;
      last = now;
      checkVpnAndWarn(true);
    } catch (e) {}
  }
  var el = document.getElementById('vpnWarning');
  if (el) (function () {
    var sx = 0, sy = 0, dx = 0, dy = 0, t0 = 0, drag = false, moved = false, pid = null;
    function reset() { el.style.transition = ''; el.style.transform = ''; el.style.opacity = ''; }
    function snooze() {                                  // пользователь убрал уведомление — 10 минут не напоминаем
      window._vpnSnoozeUntil = Date.now() + 10 * 60 * 1000;
      try { showToast('VPN-уведомление скрыто на 10 минут'); } catch (e) {}
    }
    function hideNow() {
      try { clearTimeout(_vpnWarningTimeout); } catch (e) {}   // let из основного скрипта виден глобально
      el.classList.add('hiding');
      setTimeout(function () { el.classList.remove('show', 'hiding'); reset(); }, 600);
    }
    el.addEventListener('pointerdown', function (e) {
      drag = true; moved = false; pid = e.pointerId;
      sx = e.clientX; sy = e.clientY; dx = dy = 0; t0 = Date.now();
      try { clearTimeout(_vpnWarningTimeout); } catch (er) {}   // пока держим — не скрываем по таймеру
      try { el.setPointerCapture(pid); } catch (er) {}
      el.style.transition = 'none';
    });
    el.addEventListener('pointermove', function (e) {
      if (!drag || e.pointerId !== pid) return;
      dx = e.clientX - sx; dy = e.clientY - sy;
      if (Math.abs(dx) > 6 || Math.abs(dy) > 6) moved = true;
      if (dy > 0) dy = dy * 0.15;                     // вниз тянется с сопротивлением
      el.style.transform = 'translateX(calc(-50% + ' + dx + 'px)) translateY(' + dy + 'px)';
      el.style.opacity = String(Math.max(0.2, 1 - Math.max(Math.abs(dx) / 260, -dy / 140)));
    });
    function end(e) {
      if (!drag || (e && e.pointerId !== pid)) return;
      drag = false;
      try { el.releasePointerCapture(pid); } catch (er) {}
      var dt = Math.max(1, Date.now() - t0);
      var vx = dx / dt, vy = dy / dt;                 // px/мс
      var out = (-dy > 40) || (Math.abs(dx) > 90) || (vy < -0.5) || (Math.abs(vx) > 0.6);
      if (!moved) { snooze(); hideNow(); return; }    // обычный тап — закрыть
      if (out) {
        // улетает в сторону жеста
        var horiz = Math.abs(dx) > Math.abs(dy);
        var tx = horiz ? (dx > 0 ? 600 : -600) : dx;
        var ty = horiz ? dy : -300;
        el.style.transition = 'transform .28s cubic-bezier(.4,0,1,1), opacity .28s ease';
        el.style.transform = 'translateX(calc(-50% + ' + tx + 'px)) translateY(' + ty + 'px)';
        el.style.opacity = '0';
        try { clearTimeout(_vpnWarningTimeout); } catch (er) {}
        snooze();
        setTimeout(function () { el.classList.remove('show', 'hiding'); reset(); }, 300);
      } else {
        // не дотянули — пружинно возвращается и снова скрывается по таймеру
        el.style.transition = 'transform .35s cubic-bezier(.22,1.4,.36,1), opacity .2s ease';
        el.style.transform = ''; el.style.opacity = '';
        _vpnWarningTimeout = setTimeout(hideNow, 6000);
      }
    }
    el.addEventListener('pointerup', end);
    el.addEventListener('pointercancel', end);
    el.addEventListener('click', function (e) { e.stopPropagation(); });   // тап обрабатываем в pointerup
  })();
  // старт: сеть при запуске часто ещё не готова — проверяем дважды
  setTimeout(function () { run('start'); }, 2000);
  setTimeout(function () {                      // вторая попытка нужна, только если первая не дозвонилась
    try { if (typeof _vpnLastOk !== 'undefined' && Date.now() - _vpnLastOk < 30000) return; } catch (e) {}
    last = 0; run('start2');
  }, 9000);
