function initMeetingsSwipe() {
  const swiper = document.querySelector('.meetings-swiper');
  if (!swiper) return;

  // ─── Тап по точкам ───
  document.querySelectorAll('.meetings-dots .dot').forEach(dot => {
    dot.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = Number(dot.dataset.dot);
      vibro(10);
      goToMeetingsSlide(idx);
    });
  });

  // ─── Свайп ───
  let startX = 0, startY = 0;
  let tracking = false, decided = false, isHorizontal = false;
  const MIN_DX = 50;
  const MAX_DY = 80;

  swiper.addEventListener('touchstart', (e) => {
    if (e.touches.length !== 1) return;

    // Исключения
    if (e.target.closest('input, textarea, button, select')) return;

    const t = e.touches[0];
    startX = t.clientX;
    startY = t.clientY;
    tracking = true;
    decided = false;
    isHorizontal = false;
  }, { passive: true });

  swiper.addEventListener('touchmove', (e) => {
    if (!tracking) return;
    const t = e.touches[0];
    if (!t) return;
    const dx = t.clientX - startX;
    const dy = t.clientY - startY;

    if (!decided) {
      if (Math.abs(dx) < 10 && Math.abs(dy) < 10) return;
      decided = true;
      if (Math.abs(dy) > Math.abs(dx) * 1.2) {
        tracking = false;
        return;
      }
      isHorizontal = true;
    }
  }, { passive: true });

  swiper.addEventListener('touchend', (e) => {
    if (!tracking || !decided || !isHorizontal) {
      tracking = false;
      decided = false;
      isHorizontal = false;
      return;
    }

    const touch = e.changedTouches[0];
    const dx = touch.clientX - startX;
    const dy = touch.clientY - startY;

    tracking = false;
    decided = false;
    isHorizontal = false;

    if (Math.abs(dx) < MIN_DX) return;
    if (Math.abs(dy) > MAX_DY) return;

    if (dx < 0) {
      // Свайп влево → следующий (B2B)
      goToMeetingsSlide(_meetingsSlide + 1);
      vibro(10);
    } else {
      // Свайп вправо → предыдущий (B2C)
      goToMeetingsSlide(_meetingsSlide - 1);
      vibro(10);
    }
  }, { passive: true });

  swiper.addEventListener('touchcancel', () => {
    tracking = false;
    decided = false;
    isHorizontal = false;
  }, { passive: true });
}

