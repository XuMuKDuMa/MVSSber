    ta.setAttribute('lang', 'ru'); ta.setAttribute('inputmode', 'text'); ta.setAttribute('autocapitalize', 'sentences');
    ta.setAttribute('autocomplete', 'off'); ta.setAttribute('spellcheck', 'true'); ta.setAttribute('enterkeyhint', 'done');
