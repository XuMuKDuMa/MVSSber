function vpnFirstOk(tasks) {
  return new Promise((resolve, reject) => {
    let left = tasks.length;
    tasks.forEach(t => t.then(v => {
      if (v) resolve(v);
      else if (--left === 0) reject(new Error('no data'));
    }, () => {
      if (--left === 0) reject(new Error('all failed'));
    }));
  });
}
