(() => {
  const modal = document.getElementById('daDataKeyModal');
  const input = document.getElementById('daDataKeyInput');
  const close = () => { if (modal) modal.style.display = 'none'; };
  document.getElementById('btnDaDataKey')?.addEventListener('click', () => {
    document.getElementById('menu3')?.classList.remove('show');
    try { input.value = localStorage.getItem('mvs_dadata_api_key') || ''; } catch (_) { input.value = ''; }
    modal.style.display = 'flex'; input.focus();
  });
  document.getElementById('daDataKeyCancel')?.addEventListener('click', close);
  document.getElementById('daDataKeySave')?.addEventListener('click', () => {
    const value = input.value.trim();
    if (!value) { showToast('Введите ключ DaData или нажмите «Удалить ключ».'); return; }
    try { localStorage.setItem('mvs_dadata_api_key', value); close(); showToast('Ключ DaData сохранён в этом браузере.'); }
    catch (_) { showToast('Не удалось сохранить ключ в браузере.'); }
  });
  document.getElementById('daDataKeyClear')?.addEventListener('click', () => {
    try { localStorage.removeItem('mvs_dadata_api_key'); } catch (_) {}
    input.value = ''; close(); showToast('Ключ DaData удалён.');
  });
  modal?.addEventListener('click', e => { if (e.target === modal) close(); });
})();

